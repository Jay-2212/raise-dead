+ document.addEventListener('touchend',function(e){var t=e.changedTouches[0];var dx=t.clientX-sx,dy=t.clientY-sy;if(Math.abs(dx)<20&&Math.abs(dy)<20){fire(13);return;}if(Math.abs(dx)>Math.abs(dy))fire(dx>0?39:37);else fire(dy>0?40:38);},{passive:true});
+ window.addEventListener('load',function(){document.getElementById('canvas').focus();});
+})();
+</script>
+<script src="static/script/game.js"></script><script src="static/script/index.js"></script></body></html>
