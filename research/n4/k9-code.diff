+<script>
+(function(){
+ const parts=['freedoom1.wad.part0','freedoom1.wad.part1'];const TOTAL=28795076;
+ const bar=document.querySelector('#bar>i'),pct=document.getElementById('pct'),start=document.getElementById('start');
+ let got=0;
+ async function fetchPart(u){const r=await fetch(u);if(!r.ok)throw new Error(u+' '+r.status);const rd=r.body.getReader();const chunks=[];for(;;){const{done,value}=await rd.read();if(done)break;chunks.push(value);got+=value.length;const p=Math.min(100,Math.round(got/TOTAL*100));bar.style.width=p+'%';pct.textContent=p+'%';}return chunks;}
+ window.__wadPromise=(async()=>{const all=[];for(const p of parts){all.push(...await fetchPart(p));}const out=new Uint8Array(got);let o=0;for(const c of all){out.set(c,o);o+=c.length;}return out;})();
