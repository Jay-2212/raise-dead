diff --git a/public/games/bounce/index.html b/public/games/bounce/index.html
new file mode 100644
index 0000000..555c179
--- /dev/null
+++ b/public/games/bounce/index.html
@@ -0,0 +1,113 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>The Bouncing Logo — risen</title>
+<style>
+  html,body{margin:0;height:100%;background:#000;overflow:hidden;font-family:system-ui,sans-serif;color:#d9f2ee;user-select:none}
+  canvas{display:block;width:100vw;height:100vh}
+  #hud{position:fixed;left:0;right:0;top:8px;text-align:center;font-size:13px;letter-spacing:.5px;opacity:.85;pointer-events:none;text-shadow:0 0 6px #000}
+  #hud b{color:#7fe0cf}
+  #help{position:fixed;left:0;right:0;bottom:10px;text-align:center;font-size:12px;opacity:.6;pointer-events:none}
+  #cheer{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;font-size:min(9vw,64px);font-weight:800;color:#fff;text-shadow:0 0 18px #7fe0cf,0 0 40px #7fe0cf;opacity:0;pointer-events:none;transition:opacity .25s}
+</style>
+</head>
+<body>
+<canvas id="c"></canvas>
+<div id="hud">Edges: <b id="edges">0</b> &nbsp;·&nbsp; Corners: <b id="corners">0</b> &nbsp;·&nbsp; Speed <b id="spd">1×</b></div>
+<div id="help">Waiting for the perfect corner. Space / tap = fast-forward · C = cheat (aim for a corner) · M = sound</div>
+<div id="cheer">CORNER!!!</div>
+<script>
+(() => {
+  // Original tribute to the idle "bouncing logo" screensaver. Our own RIP logo; no third-party marks.
+  const c = document.getElementById('c'), g = c.getContext('2d');
+  const elE = document.getElementById('edges'), elC = document.getElementById('corners'), elS = document.getElementById('spd'), cheer = document.getElementById('cheer');
+  const COLORS = ['#7fe0cf', '#f08a24', '#c58cff', '#ff6b8b', '#ffe066', '#7cc4ff', '#9dff7a'];
+  let W = 0, H = 0, dpr = 1;
+  const logo = { w: 150, h: 72, x: 40, y: 30, vx: 1, vy: 1, color: 0 };
+  let speed = 1, fast = false, edges = 0, corners = 0, sound = true, ac = null, confetti = [];
+  function resize() {
+    dpr = Math.min(2, window.devicePixelRatio || 1);
+    W = window.innerWidth; H = window.innerHeight;
+    c.width = W * dpr; c.height = H * dpr; g.setTransform(dpr, 0, 0, dpr, 0, 0);
+    logo.w = Math.max(90, Math.min(170, W * 0.22)); logo.h = logo.w * 0.48;
+    logo.x = Math.min(logo.x, W - logo.w); logo.y = Math.min(logo.y, H - logo.h);
+  }
+  window.addEventListener('resize', resize); resize();
+  function beep(f, d) {
+    if (!sound) return;
+    try {
+      ac = ac || new (window.AudioContext || window.webkitAudioContext)();
+      const o = ac.createOscillator(), v = ac.createGain();
+      o.type = 'triangle'; o.frequency.value = f; v.gain.value = 0.06;
+      o.connect(v); v.connect(ac.destination); o.start();
+      v.gain.exponentialRampToValueAtTime(0.0001, ac.currentTime + d); o.stop(ac.currentTime + d);
+    } catch (e) {}
+  }
+  function drawLogo() {
+    const { x, y, w, h } = logo, col = COLORS[logo.color];
+    g.save();
+    g.shadowColor = col; g.shadowBlur = 18;
+    g.fillStyle = col;
+    // disc under the word, like the classic logo
+    g.beginPath(); g.ellipse(x + w / 2, y + h * 0.82, w * 0.46, h * 0.14, 0, 0, Math.PI * 2); g.fill();
+    g.font = `900 ${Math.round(h * 0.62)}px Georgia, serif`; g.textAlign = 'center'; g.textBaseline = 'alphabetic';
+    g.fillText('R.I.P', x + w / 2, y + h * 0.6);
+    g.fillStyle = '#000'; g.shadowBlur = 0;
+    g.font = `700 ${Math.round(h * 0.16)}px system-ui, sans-serif`;
+    g.fillText('SCREENSAVER', x + w / 2, y + h * 0.87);
+    g.restore();
+  }
+  function hitCorner() {
+    corners++; elC.textContent = corners;
+    cheer.style.opacity = 1; setTimeout(() => (cheer.style.opacity = 0), 1600);
+    [523, 659, 784, 1047].forEach((f, i) => setTimeout(() => beep(f, 0.25), i * 110));
+    for (let i = 0; i < 120; i++) confetti.push({ x: W / 2, y: H / 2, vx: (Math.random() - .5) * 9, vy: (Math.random() - .9) * 9, c: COLORS[i % COLORS.length], life: 120 });
+  }
+  function cheat() {
+    // choose a velocity that lands exactly in the nearest corner on the next wall contact
+    const cx = logo.vx > 0 ? W - logo.w : 0, cy = logo.vy > 0 ? H - logo.h : 0;
+    const dx = Math.abs(cx - logo.x), dy = Math.abs(cy - logo.y), t = Math.max(dx, dy) || 1;
+    const s = Math.hypot(logo.vx, logo.vy);
+    logo.vx = Math.sign(logo.vx) * (dx / t); logo.vy = Math.sign(logo.vy) * (dy / t);
+    const n = Math.hypot(logo.vx, logo.vy) || 1; logo.vx *= s / n; logo.vy *= s / n;
+  }
+  let last = performance.now();
+  function frame(now) {
+    const dt = Math.min(50, now - last) / 16.67; last = now;
+    const steps = fast ? 12 : 1;
+    for (let k = 0; k < steps; k++) {
+      logo.x += logo.vx * 2.2 * dt; logo.y += logo.vy * 2.2 * dt;
+      let hx = false, hy = false;
+      if (logo.x <= 0) { logo.x = 0; logo.vx = Math.abs(logo.vx); hx = true; }
+      if (logo.x + logo.w >= W) { logo.x = W - logo.w; logo.vx = -Math.abs(logo.vx); hx = true; }
+      if (logo.y <= 0) { logo.y = 0; logo.vy = Math.abs(logo.vy); hy = true; }
+      if (logo.y + logo.h >= H) { logo.y = H - logo.h; logo.vy = -Math.abs(logo.vy); hy = true; }
+      if (hx || hy) {
+        edges++; elE.textContent = edges;
+        logo.color = (logo.color + 1 + Math.floor(Math.random() * (COLORS.length - 1))) % COLORS.length;
+        // near-corner tolerance: within 4 px on the other axis counts
+        const nearX = logo.x <= 4 || logo.x + logo.w >= W - 4, nearY = logo.y <= 4 || logo.y + logo.h >= H - 4;
+        if ((hx && nearY) || (hy && nearX)) { hitCorner(); fast = false; elS.textContent = '1×'; }
+        else if (!fast) beep(220 + Math.random() * 60, 0.05);
+      }
+    }
+    g.fillStyle = '#000'; g.fillRect(0, 0, W, H);
+    drawLogo();
+    confetti = confetti.filter((p) => p.life-- > 0);
+    for (const p of confetti) { p.vy += 0.15; p.x += p.vx; p.y += p.vy; g.fillStyle = p.c; g.fillRect(p.x, p.y, 4, 4); }
+    requestAnimationFrame(frame);
+  }
+  function toggleFast() { fast = !fast; elS.textContent = fast ? '12×' : '1×'; }
+  window.addEventListener('keydown', (e) => {
+    if (e.code === 'Space') { e.preventDefault(); toggleFast(); }
+    if (e.key === 'c' || e.key === 'C') cheat();
+    if (e.key === 'm' || e.key === 'M') sound = !sound;
+  });
+  c.addEventListener('pointerdown', toggleFast);
+  requestAnimationFrame(frame);
+})();
+</script>
+</body>
+</html>
