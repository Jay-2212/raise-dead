+    doneText: 'satelliteRepaired', states: [12], stageCounters: [3], doneBox: 'mission', doneTextAlt: null },
+  13: { id: 13, key: 'recon', name: 'Recon', counter: 15, accept: 20000, reward: 1250000, rankPts: 9,
