+  const shapes = [];
+  for (let i = 0; i < 30; i++) shapes.push({ kind: ri(rand, 0, 4), x: rr(rand, 0, w), y: rr(rand, 0, h), s: rr(rand, 10, 26) * k, a: rr(rand, 0, TAU), c: cols[ri(rand, 0, cols.length - 1)] });
