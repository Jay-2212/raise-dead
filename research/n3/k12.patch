+  for (let k = -span; k < span * 1.2; k += 0.34) {
+    const px = x0 + k, py = y0;
+    ctx.moveTo(px - c * span, py - s * span);
+    ctx.lineTo(px + c * span, py + s * span);
+  }
+  ctx.stroke();
+  ctx.restore();
+  ctx.strokeStyle = rgba('#000000', 0.7);
+  ctx.lineWidth = 0.03;
+  ctx.strokeRect(x0, y0, w, h);
