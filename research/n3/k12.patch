@@ -0,0 +1,369 @@
+/**
+ * src/lamps/group.js
+ * OWNER: LAMPS
+ * STATUS: IMPLEMENTED
+ * CONTRACT: ARCHITECTURE.md 6.1, 6.3; SPEC 5.13.3 (TLightGroup)
+ * class LightGroup implements the LampGroup typedef (src/types.js): an ordered list of Lamp members plus the group verbs, the chase / light-show /
+ * game-over animations (one shared step timer) and the decay "notify" timer.
+ *
+ * Layers: S (steady) is the rules' layer: nextOn / dropTop / offsetForward / stepForward / stepBackward / flashWhenOn / broadcast work on it.
+ * The animations work on the OVERLAY layer (FORCE_ON / FORCE_OFF on every member, mirroring S when they start); groupReset() removes it again.
+ * gameOver() is the exception: it writes the steady layer (ResetAndToggleValue), as the original does.
+ *
+ * ASSUMPTIONS (gap protocol):
+ *  - Direction names: Backward = the pattern moves toward HIGHER member index (same as stepBackward); Forward = toward lower index, both with wrap.
+ *  - animationForward/Backward always re-mirror S and restart the step timer (SPEC: "if an animation is running or none: mirror()"), the first frame is
+ *    already shifted by one and runs synchronously inside the call.
+ *  - lightShow's first pulse tick happens one period after the call (SPEC 5.2.1 "every 0.2 s"); gameOver's first tick runs immediately (SPEC 5.2.7).
+ *  - The "29 %" test is the original's `floor(rand()*100) > 70` (29 of 100 values), one rand() per member per tick (index order), one more rand()
+ *    for the pulse length u in lightShow when the member is hit.
+ *  - The group "register" of SPEC 5.13.5 is always 0 in this build; it is kept as an internal integer that playerChanged saves / restores. A running
+ *    animation is never resumed after a player change, so isAnimating() is false afterwards.
+ *  - onNotifyExpired() may be registered on any group (the rules use it on hyperspace_lights, bumper_target_lights, top_target_lights).
+ *    restartNotifyTimer(t <= 0) only cancels. The notify timer is NOT touched by groupReset() (SPEC) but is cancelled by resetAll / playerChanged.
+ *  - Group animations skip lamps held dark by the tilt blackout (Lamp.tiltHold): they keep running invisibly during a tilt (SPEC 5.2.8).
+ *  - broadcast() accepts the LampVerbName verbs plus 'setField' and 'setOnIdx' (rules use field(group) = 0, SPEC 5.2.4).
+ */
+import { secondsToMs, timeoutMs } from './wheel.js';
+
+/** Probability test of the original: `floor(rand * 100) > 70` is true for 29 of the 100 values. */
+const HIT_PERCENT_THRESHOLD = 70;
+
+/** @type {Record<string, (lamp: import('./lamp.js').Lamp, arg: number) => void>} verb table of broadcast() */
+const VERBS = {
+  turnOn: (l) => l.turnOn(),
+  turnOff: (l) => l.turnOff(),
+  on: (l) => l.on(),
+  off: (l) => l.off(),
+  flash: (l, a) => l.flash(a),
+  flasherStart: (l) => l.flasherStart(),
+  flashThenOn: (l, a) => l.flashThenOn(a),
+  flashThenOff: (l, a) => l.flashThenOff(a),
+  timedOn: (l, a) => l.timedOn(a),
+  timedOff: (l, a) => l.timedOff(a),
+  resetTimed: (l) => l.resetTimed(),
+  toggleValue: (l, a) => l.toggleValue(a),
+  resetAndToggleValue: (l, a) => l.resetAndToggleValue(a),
+  setField: (l, a) => l.setField(a),
+  setOnIdx: (l, a) => l.setOnIdx(a),
+};
+
+export class LightGroup {
+  /**
+   * @param {import('./wheel.js').TimerWheel} wheel
+   * @param {string} name
+   * @param {import('./lamp.js').Lamp[]} lamps members in group order
+   * @param {number} defaultStep default animation period in seconds (attr 903)
+   * @param {() => number} rand injected Rand01
+   */
+  constructor(wheel, name, lamps, defaultStep, rand) {
+    this.name = name;
+    this._wheel = wheel;
+    this._lamps = lamps;
+    /** @type {string[]} member lamp names, group order */
+    this.members = lamps.map((l) => l.name);
+    this._rand = rand;
+    this._defaultStepMs = Math.max(1, secondsToMs(defaultStep > 0 ? defaultStep : 0.08));
+    /** @type {'none'|'chase'|'lightShow'|'gameOver'} */ this._kind = 'none';
+    /** +1: pattern moves toward higher index (Backward), -1: toward lower index (Forward) */ this._dir = 1;
+    this._stepH = 0;
+    this._stepMs = this._defaultStepMs;
+    this._stepSeconds = 0.2;
+    this._pat = new Uint8Array(lamps.length);
+    this._notifyH = 0;
+    /** @type {null | ((group:string)=>void)} */ this._notifyFn = null;
+    this._register = 0;
+    this._slots = [0, 0, 0, 0];
+    this._onStepFn = () => this._onStep();
+    this._onNotifyFn = () => this._onNotify();
+  }
+
+  // ---- queries ---------------------------------------------------------------------------------------------------------------------------
+  /** GetOnCount: members whose steady flag S is true. @returns {number} */
+  count() {
+    let n = 0;
+    const lamps = this._lamps;
+    for (let i = 0; i < lamps.length; i++) if (lamps[i].S) n++;
+    return n;
+  }
+
+  /** An animation (chase / light show / game over) is running. @returns {boolean} */
+  isAnimating() { return this._kind !== 'none'; }
+
+  /** The LAST member is flashing. @returns {boolean} */
+  lastFlashing() {
+    const n = this._lamps.length;
+    return n > 0 && this._lamps[n - 1].overlay === 'flash';
+  }
+
+  // ---- steady-layer verbs ----------------------------------------------------------------------------------------------------------------
+  /**
+   * ResetAndTurnOn(t): the first unlit member (lowest index, S false) does flashThenOn(t).
+   * @param {number} [t] seconds (default 2.0; 5.0 for a rank promotion)
+   * @returns {boolean} false (and nothing happens) when every member is lit
+   */
+  nextOn(t = 2.0) {
+    const lamps = this._lamps;
+    for (let i = 0; i < lamps.length; i++) {
+      if (!lamps[i].S) {
+        if (this._kind !== 'none') this.groupReset();            // research/rules.md L5 #41: "if an animation is running: GroupReset" first
+        lamps[i].flashThenOn(t);
+        return true;
+      }
+    }
+    return false;
+  }
+
+  /**
+   * OffsetAnimationBackward: steady-off (no flash) the highest-index lit member. While an overlay animation (chase / light show) runs the group
+   * re-mirrors its steady layer afterwards (research/rules.md L5 #33), otherwise the stale animation pattern would keep showing the dropped lamp.
+   * @returns {boolean} false if none is lit
+   */
+  dropTop() {
+    const lamps = this._lamps;
+    for (let i = lamps.length - 1; i >= 0; i--) {
+      if (lamps[i].S) { lamps[i].off(); this._resync(); return true; }
+    }
+    return false;
+  }
+
+  /** OffsetAnimationForward: steady-on (no flash) the first unlit member (re-mirrors a running overlay animation like dropTop). @returns {boolean} false if every member is lit */
+  offsetForward() {
+    const lamps = this._lamps;
+    for (let i = 0; i < lamps.length; i++) {
+      if (!lamps[i].S) { lamps[i].on(); this._resync(); return true; }
+    }
+    return false;
+  }
+
+  /** The steady layer changed under a running overlay animation (chase / light show): mirror() again so the pattern follows S. */
+  _resync() {
+    if (this._kind === 'chase' || this._kind === 'lightShow') this._mirror();
+  }
+
+  /** StepBackward(0): rotate the steady layer (S, field) toward HIGHER index with wrap; no-op while the last member is flashing / in any overlay. */
+  stepBackward() {
+    const lamps = this._lamps;
+    const n = lamps.length;
+    if (n < 2 || lamps[n - 1].overlay !== 'none') return;
+    const lastS = lamps[n - 1].S;
+    const lastF = lamps[n - 1].field;
+    for (let i = n - 1; i > 0; i--) { lamps[i].S = lamps[i - 1].S; lamps[i].field = lamps[i - 1].field; }
+    lamps[0].S = lastS;
+    lamps[0].field = lastF;
+  }
+
+  /** StepForward(0): rotate the steady layer (S, field) toward LOWER index with wrap; no-op while the last member is flashing / in any overlay. */
+  stepForward() {
+    const lamps = this._lamps;
+    const n = lamps.length;
+    if (n < 2 || lamps[n - 1].overlay !== 'none') return;
+    const firstS = lamps[0].S;
+    const firstF = lamps[0].field;
+    for (let i = 0; i < n - 1; i++) { lamps[i].S = lamps[i + 1].S; lamps[i].field = lamps[i + 1].field; }
+    lamps[n - 1].S = firstS;
+    lamps[n - 1].field = firstF;
+  }
+
+  /**
+   * FlashWhenOn(t): every lit member (S true) gets S = false now and then blinks t seconds and ends off (skill-shot award, t = 1.0).
+   * @param {number} t seconds
+   */
+  flashWhenOn(t) {
+    const lamps = this._lamps;
+    for (let i = 0; i < lamps.length; i++) {
+      const l = lamps[i];
+      if (!l.S) continue;
+      l.S = false;
+      l.flashThenOff(t);
+    }
+  }
+
+  /**
+   * Apply a lamp verb to every member, LAST member first (SPEC 5.13: unhandled group messages are broadcast to every member).
+   * @param {import('../types.js').LampVerbName | 'setField' | 'setOnIdx'} verb
+   * @param {number} [arg] seconds for the timed verbs, the value for toggleValue / setField / setOnIdx
+   */
+  broadcast(verb, arg) {
+    if (typeof verb !== 'string' || !Object.prototype.hasOwnProperty.call(VERBS, verb)) {
+      throw new TypeError(`unknown lamp verb "${String(verb)}"`);
+    }
+    const fn = VERBS[verb];
+    const lamps = this._lamps;
+    for (let i = lamps.length - 1; i >= 0; i--) fn(lamps[i], /** @type {number} */ (arg));
+  }
+
+  // ---- animations (overlay layer) --------------------------------------------------------------------------------------------------------
+  /** @param {number|undefined} step seconds; <= 0 / omitted = group default @returns {number} ms */
+  _periodMs(step) { return step !== undefined && step > 0 ? timeoutMs(step) : this._defaultStepMs; }
+
+  _cancelStep() {
+    if (this._stepH) { this._wheel.cancel(this._stepH); this._stepH = 0; }
+  }
+
+  /** mirror(): give every member a FORCE_ON / FORCE_OFF overlay that mirrors its S and remember that pattern. */
+  _mirror() {
+    const lamps = this._lamps;
+    for (let i = lamps.length - 1; i >= 0; i--) {
+      this._pat[i] = lamps[i].S ? 1 : 0;
+      lamps[i]._animSet(lamps[i].S);
+    }
+  }
+
+  /** Rotate the remembered overlay pattern one place in `_dir` and write it to the members. */
+  _rotateOverlay() {
+    const p = this._pat;
+    const n = p.length;
+    if (n > 1) {
+      if (this._dir > 0) {
+        const last = p[n - 1];
+        for (let i = n - 1; i > 0; i--) p[i] = p[i - 1];
+        p[0] = last;
+      } else {
+        const first = p[0];
+        for (let i = 0; i < n - 1; i++) p[i] = p[i + 1];
+        p[n - 1] = first;
+      }
+    }
+    const lamps = this._lamps;
+    for (let i = 0; i < n; i++) lamps[i]._animSet(p[i] === 1);
+  }
+
+  /** @param {1|-1} dir @param {number|undefined} step */
+  _startChase(dir, step) {
+    this._cancelStep();
+    this._mirror();
+    this._kind = 'chase';
+    this._dir = dir;
+    this._stepMs = this._periodMs(step);
+    this._rotateOverlay();
+    this._stepH = this._wheel.schedule(this._stepMs, this._onStepFn, 0);
+  }
+
+  /**
+   * AnimationBackward(step): chase on the overlay layer, the pattern moves toward higher index every `step` seconds until groupReset().
+   * @param {number} [step] seconds; <= 0 / omitted = the group default (attr 903)
+   */
+  animationBackward(step) { this._startChase(1, step); }
+
+  /**
+   * AnimationForward(step): like animationBackward but the pattern moves toward lower index.
+   * @param {number} [step] seconds; <= 0 / omitted = the group default
+   */
+  animationForward(step) { this._startChase(-1, step); }
+
+  /**
+   * LightShowAnimation: mirror(); every `step` seconds each member has a 29 % chance of TurnOnTimed(0.1 + u * 3 * step).
+   * @param {number} [step] seconds (default 0.2)
+   */
+  lightShow(step = 0.2) {
+    const s = step > 0 ? step : 0.2;
+    this._cancelStep();
+    this._mirror();
+    this._kind = 'lightShow';
+    this._stepSeconds = s;
+    this._stepMs = timeoutMs(s);
+    this._stepH = this._wheel.schedule(this._stepMs, this._onStepFn, 0);
+  }
+
+  /**
+   * GameOverAnimation: immediately and every `step` seconds each member gets ResetAndToggleValue(1 with 29 %, else 0).
+   * @param {number} [step] seconds (default 1.4)
+   */
+  gameOver(step = 1.4) {
+    const s = step > 0 ? step : 1.4;
+    this._cancelStep();
+    this._kind = 'gameOver';
+    this._stepMs = timeoutMs(s);
+    this._gameOverTick();
+    this._stepH = this._wheel.schedule(this._stepMs, this._onStepFn, 0);
+  }
+
+  _gameOverTick() {
+    const lamps = this._lamps;
+    for (let i = 0; i < lamps.length; i++) {
+      lamps[i].resetAndToggleValue(Math.floor(this._rand() * 100) > HIT_PERCENT_THRESHOLD ? 1 : 0);
+    }
+  }
+
+  _lightShowTick() {
+    const lamps = this._lamps;
+    for (let i = 0; i < lamps.length; i++) {
+      if (Math.floor(this._rand() * 100) > HIT_PERCENT_THRESHOLD) {
+        const u = this._rand();
+        if (!lamps[i].tiltHold) lamps[i].timedOn(0.1 + u * 3 * this._stepSeconds);
+      }
+    }
+  }
+
+  _onStep() {
+    this._stepH = 0;
+    switch (this._kind) {
+      case 'chase': this._rotateOverlay(); break;
+      case 'lightShow': this._lightShowTick(); break;
+      case 'gameOver': this._gameOverTick(); break;
+      default: return;
+    }
+    if (this._kind !== 'none' && !this._stepH) this._stepH = this._wheel.schedule(this._stepMs, this._onStepFn, 0);
+  }
+
+  /** GroupReset: cancel the step timer; if an OVERLAY animation (chase / light show) was running remove its overlays (ResetTimed broadcast). S untouched. */
+  groupReset() {
+    this._cancelStep();
+    const overlayAnimation = this._kind === 'chase' || this._kind === 'lightShow';
+    this._kind = 'none';
+    if (overlayAnimation) {
+      const lamps = this._lamps;
+      for (let i = lamps.length - 1; i >= 0; i--) lamps[i]._animReset();
+    }
+  }
+
+  // ---- decay (notify) timer --------------------------------------------------------------------------------------------------------------
+  /**
+   * RestartNotifyTimer(t): (re)start the decay timer. On expiry the group ONLY raises the handler (rules do dropTop(), restart, lower the multiplier).
+   * t <= 0 just cancels it.
+   * @param {number} t seconds
+   */
+  restartNotifyTimer(t) {
+    if (this._notifyH) { this._wheel.cancel(this._notifyH); this._notifyH = 0; }
+    const ms = timeoutMs(t);
+    if (ms > 0) this._notifyH = this._wheel.schedule(ms, this._onNotifyFn, 0);
+  }
+
+  /** ControlNotifyTimerExpired handler; replaces any previous one. @param {null | ((group:string)=>void)} fn */
+  onNotifyExpired(fn) {
+    if (fn !== null && fn !== undefined && typeof fn !== 'function') throw new TypeError('onNotifyExpired: fn must be a function or null');
+    this._notifyFn = fn || null;
+  }
+
+  _onNotify() {
+    this._notifyH = 0;
+    const fn = this._notifyFn;
+    if (fn) fn(this.name);
+  }
+
+  // ---- reset / per-player (used by the Lamps facade) --------------------------------------------------------------------------------------
+  /** Drop all timers and animation state (no lamp is touched). Bargraph extends this. */
+  _dropState() {
+    this._cancelStep();
+    this._kind = 'none';
+    if (this._notifyH) { this._wheel.cancel(this._notifyH); this._notifyH = 0; }
+    this._register = 0;
+  }
+
+  /** Reset() for a new game: all group state dropped, saved per-player registers cleared. Members are reset by the facade. Registered hooks are kept. */
+  hardReset() {
+    this._dropState();
+    this._slots.fill(0);
+  }
+
+  /**
+   * PlayerChanged (SPEC 5.13.5): save the register into the outgoing slot, Reset(), load the incoming slot. A running animation is not resumed.
+   * @param {number} outgoing 0..3 @param {number} incoming 0..3
+   */
+  playerChanged(outgoing, incoming) {
+    this._slots[outgoing] = this._register;
+    this._dropState();
+    this._register = this._slots[incoming] | 0;
+  }
+}
diff --git a/public/games/space-cadet/src/lamps/lamp.js b/public/games/space-cadet/src/lamps/lamp.js
new file mode 100644
index 0000000..222109c
--- /dev/null
+++ b/public/games/space-cadet/src/lamps/lamp.js
@@ -0,0 +1,233 @@
+/**
+ * src/lamps/lamp.js
+ * OWNER: LAMPS
+ * STATUS: IMPLEMENTED
+ * CONTRACT: ARCHITECTURE.md 6.1, 6.2; SPEC 5.13.1-5.13.2, 5.13.6 (TLight)
+ * class Lamp: S, overlay, phase, offAfter, timeout, flash timer, field, onIdx + all verbs.
+ *
+ * State (SPEC 5.13.1): `S` steady flag; `overlay` 'none'|'flash'|'on'|'off' (mutually exclusive; 'on' = FORCE_ON, 'off' = FORCE_OFF); `phase` current flash
+ * phase (true = lit); `offAfter` (clear S when the shared timeout fires); ONE shared timeout (every timed verb replaces it); the flash toggle timer;
+ * `field` scratch register; `onIdx` which ON image (lite2/3/4 have 3).
+ *
+ * Visual vs rules state: isLit() is overlay-aware (render); lightOn() = S || FORCE_ON || FLASH (every rule test - FORCE_OFF does not count as off).
+ *
+ * Re-entrancy: the lamp finishes its own state update BEFORE it raises the ControlTimerExpired hook; the hook may call any verb on any lamp,
+ * including this one. Nothing here holds an iterator while calling out.
+ *
+ * ASSUMPTIONS (gap protocol):
+ *  - Timeout and flash-phase durations are whole ms (secondsToMs); a positive duration is at least 1 ms; flash phases are at least 1 ms.
+ *  - `ResetTimed` keeps `offAfter` exactly as SPEC 5.13.2 says (only Reset() and the flash verbs clear it).
+ *  - `tiltHold`: set by tiltBlackout() (the tilt broadcast TurnOffTimed(0)). While it is set the lamp ignores the group-animation layer
+ *    (_animSet/_animReset), so group chases keep running but stay invisible during a tilt (SPEC 5.2.8: "animations keep running but are invisible").
+ *    Any change of overlay away from FORCE_OFF clears it. It affects nothing else.
+ *  - Non-finite numeric arguments: durations <= 0 / NaN mean "none"; field / onIdx / toggle values that are not finite count as 0.
+ */
+import { secondsToMs, timeoutMs } from './wheel.js';
+
+/** @typedef {'none'|'flash'|'on'|'off'} Overlay */
+
+/** Priority of flash toggles on the TimerWheel: after any other timer due at the same millisecond (timeout beats flash toggle). */
+const FLASH_PRIORITY = 1;
+
+export class Lamp {
+  /**
+   * @param {import('./wheel.js').TimerWheel} wheel
+   * @param {{name:string, flash?:{off:number,on:number}, nStates?:number}} def  a LampDef (only name / flash / nStates are read)
+   * @param {number} index position in LAMP_NAMES
+   */
+  constructor(wheel, def, index) {
+    this.name = def.name;
+    this.index = index;
+    this._wheel = wheel;
+    this.nStates = Math.max(1, Math.floor(def.nStates || 1));
+    const flash = def.flash || { off: 0.1, on: 0.1 };
+    /** dark-phase length ms (attr 900) */ this._offMs = Math.max(1, secondsToMs(flash.off));
+    /** lit-phase length ms (attr 901) */ this._onMs = Math.max(1, secondsToMs(flash.on));
+    /** steady flag */ this.S = false;
+    /** @type {Overlay} */ this.overlay = 'none';
+    /** current flash phase (true = lit) */ this.phase = false;
+    /** clear S when the timeout fires */ this.offAfter = false;
+    /** scratch register */ this.field = 0;
+    /** which ON image */ this.onIdx = 0;
+    /** true while the tilt FORCE_OFF blackout owns the lamp */ this.tiltHold = false;
+    /** @type {null | ((lamp:string)=>void)} ControlTimerExpired hook */ this.hook = null;
+    this._timeoutH = 0;
+    this._flashH = 0;
+    this._onTimeoutFn = () => this._onTimeout();
+    this._onFlashFn = () => this._onFlash();
+  }
+
+  // ---- queries ---------------------------------------------------------------------------------------------------------------------------
+  /** Visual state: FLASH -> phase, FORCE_ON -> true, FORCE_OFF -> false, else S. @returns {boolean} */
+  isLit() {
+    switch (this.overlay) {
+      case 'flash': return this.phase;
+      case 'on': return true;
+      case 'off': return false;
+      default: return this.S;
+    }
+  }
+
+  /** light_on(): S || FORCE_ON || FLASH - the test every rule uses. @returns {boolean} */
+  lightOn() { return this.S || this.overlay === 'on' || this.overlay === 'flash'; }
+
+  /** @returns {boolean} a timeout is pending */
+  hasTimeout() { return this._timeoutH !== 0; }
+
+  // ---- internal helpers ------------------------------------------------------------------------------------------------------------------
+  /** @param {Overlay} overlay */
+  _setOverlay(overlay) {
+    this.overlay = overlay;
+    if (overlay !== 'off') this.tiltHold = false;
+  }
+
+  /** SetTimeout(t): cancel the timeout; t > 0 schedules a new one. @param {number} seconds */
+  _setTimeout(seconds) {
+    if (this._timeoutH) { this._wheel.cancel(this._timeoutH); this._timeoutH = 0; }
+    const ms = timeoutMs(seconds);
+    if (ms > 0) this._timeoutH = this._wheel.schedule(ms, this._onTimeoutFn, 0);
+  }
+
+  _cancelFlash() {
+    if (this._flashH) { this._wheel.cancel(this._flashH); this._flashH = 0; }
+  }
+
+  /** Begin the waveform: the first phase is the OPPOSITE of S and is shown immediately. */
+  _startFlash() {
+    this._cancelFlash();
+    this.phase = !this.S;
+    this._setOverlay('flash');
+    this._flashH = this._wheel.schedule(this.phase ? this._onMs : this._offMs, this._onFlashFn, FLASH_PRIORITY);
+  }
+
+  _onFlash() {
+    this._flashH = 0;
+    this.phase = !this.phase;
+    this._flashH = this._wheel.schedule(this.phase ? this._onMs : this._offMs, this._onFlashFn, FLASH_PRIORITY);
+  }
+
+  /** Timeout expiry (SPEC 5.13.1): finish ALL state changes, then raise the hook. */
+  _onTimeout() {
+    this._timeoutH = 0;
+    if (this.overlay === 'flash') this._cancelFlash();
+    this._setOverlay('none');
+    if (this.offAfter) { this.offAfter = false; this.S = false; }
+    const hook = this.hook;
+    if (hook) hook(this.name);
+  }
+
+  // ---- verbs (SPEC 5.13.2) ---------------------------------------------------------------------------------------------------------------
+  /** TurnOn: raw S = true (overlays untouched). */
+  turnOn() { this.S = true; }
+
+  /** TurnOff: raw S = false (overlays untouched). */
+  turnOff() { this.S = false; }
+
+  /** ResetTimed: cancel timeout + flash, overlay NONE; S, offAfter, field, onIdx kept. */
+  resetTimed() {
+    if (this._timeoutH) { this._wheel.cancel(this._timeoutH); this._timeoutH = 0; }
+    this._cancelFlash();
+    this._setOverlay('none');
+  }
+
+  /** ResetAndTurnOn (`lit`): S = true then ResetTimed. */
+  on() { this.S = true; this.resetTimed(); }
+
+  /** ResetAndTurnOff (`unlit`): S = false then ResetTimed. */
+  off() { this.S = false; this.resetTimed(); }
+
+  /** FlasherStart: cancel the timeout; flash indefinitely (an already running waveform is not restarted). */
+  flasherStart() {
+    this._setTimeout(0);
+    if (this.overlay !== 'flash' || !this._flashH) {
+      this._setOverlay('flash');
+      this.offAfter = false;
+      this._startFlash();
+    }
+  }
+
+  /** FlasherStartTimed(t) (`flash`): start the waveform if not flashing; timeout t (t <= 0: none, flashes until reset). @param {number} [seconds] */
+  flash(seconds) {
+    if (this.overlay !== 'flash') this._startFlash();
+    this._setOverlay('flash');
+    this.offAfter = false;
+    this._setTimeout(seconds);
+  }
+
+  /** flashThenOn: S = true now (it counts), flash t seconds, end steady lit. @param {number} seconds */
+  flashThenOn(seconds) {
+    this.offAfter = false;
+    this.S = true;
+    this.flash(seconds);
+  }
+
+  /** flashThenOff: flash t seconds, then S = false (t <= 0 flashes forever). @param {number} seconds */
+  flashThenOff(seconds) {
+    this.flash(seconds);
+    this.offAfter = true;
+  }
+
+  /** TurnOnTimed(t): FORCE_ON overlay for t seconds (stops any flash), then back to S. t <= 0: until reset. @param {number} seconds */
+  timedOn(seconds) {
+    if (this.overlay !== 'on') {
+      if (this.overlay === 'flash') this._cancelFlash();
+      this._setOverlay('on');
+    }
+    this._setTimeout(seconds);
+  }
+
+  /** TurnOffTimed(t): FORCE_OFF overlay for t seconds. t <= 0: until reset (tilt). @param {number} seconds */
+  timedOff(seconds) {
+    if (this.overlay !== 'off') {
+      if (this.overlay === 'flash') this._cancelFlash();
+      this._setOverlay('off');
+    }
+    this._setTimeout(seconds);
+  }
+
+  /** ToggleValue(v): S = floor(v) != 0. @param {number} v */
+  toggleValue(v) { this.S = Number.isFinite(v) && Math.floor(v) !== 0; }
+
+  /** ResetAndToggleValue(v): ToggleValue then ResetTimed. @param {number} v */
+  resetAndToggleValue(v) { this.toggleValue(v); this.resetTimed(); }
+
+  /** SetMessageField(v): field = floor(v). @param {number} v */
+  setField(v) { this.field = Number.isFinite(v) ? Math.floor(v) : 0; }
+
+  /** SetOnStateBmpIndex(i): onIdx = clamp(floor(i), 0, nStates - 1). @param {number} i */
+  setOnIdx(i) {
+    const n = Number.isFinite(i) ? Math.floor(i) : 0;
+    this.onIdx = n < 0 ? 0 : n > this.nStates - 1 ? this.nStates - 1 : n;
+  }
+
+  /** Reset() (new game / player change): S = false, everything cancelled, overlay NONE, offAfter = false, onIdx = 0, field = 0. The hook is kept. */
+  reset() {
+    this.S = false;
+    this.offAfter = false;
+    this.resetTimed();
+    this.phase = false;
+    this.onIdx = 0;
+    this.field = 0;
+    this.tiltHold = false;
+  }
+
+  // ---- tilt ------------------------------------------------------------------------------------------------------------------------------
+  /** The tilt broadcast: TurnOffTimed(0) and remember that the blackout owns this lamp (see ASSUMPTIONS). */
+  tiltBlackout() {
+    this.timedOff(0);
+    this.tiltHold = true;
+  }
+
+  // ---- group animation layer -------------------------------------------------------------------------------------------------------------
+  /** Group chase / light-show layer: FORCE_ON / FORCE_OFF without timeout; ignored while the tilt blackout owns the lamp. @param {boolean} lit */
+  _animSet(lit) {
+    if (this.tiltHold) return;
+    if (lit) this.timedOn(0); else this.timedOff(0);
+  }
+
+  /** Undo the group animation layer (ResetTimed), except on lamps held dark by the tilt blackout. */
+  _animReset() {
+    if (this.tiltHold) return;
+    this.resetTimed();
+  }
+}
diff --git a/public/games/space-cadet/src/lamps/wheel.js b/public/games/space-cadet/src/lamps/wheel.js
new file mode 100644
index 0000000..1c0e824
--- /dev/null
+++ b/public/games/space-cadet/src/lamps/wheel.js
@@ -0,0 +1,177 @@
+/**
+ * src/lamps/wheel.js
+ * OWNER: LAMPS
+ * STATUS: IMPLEMENTED
+ * CONTRACT: ARCHITECTURE.md 6.1; SPEC 5.13.1 (integer-ms timer wheel)
+ * TimerWheel: schedule(ms, fn)->id, cancel(id), advance(ms) fires due timers ONE AT A TIME in (time, priority, insertion) order; callbacks may
+ * schedule/cancel more timers (re-entrant); a timer scheduled during advance that is already due fires within the same advance. now() = ms elapsed.
+ *
+ * The wheel never reads a wall clock: time moves only through advance(). While a callback runs, now() is the DUE time of the timer that is firing
+ * (not the end of the advance), so "after(5 s)" scheduled from inside a callback that was due at 5000 ms lands at 10000 ms even when the whole advance was
+ * one big call.
+ *
+ * ASSUMPTIONS:
+ *  - schedule() takes an optional third argument `priority` (default 0). Timers due at the same millisecond fire by ascending priority, then by insertion
+ *    order. The lamp flash toggles use priority 1, every other timer 0, which implements "a timeout and a flash toggle on the same ms: the timeout wins"
+ *    (SPEC 5.13.1) even when the toggle was inserted first.
+ *  - A callback that calls advance() (misuse) does not recurse: the extra time is added to the running advance.
+ *  - Delays are truncated to whole milliseconds; negative / NaN delays mean 0 (fires within the current advance, or at the next advance).
+ *  - Timer records are pooled: after warm-up a schedule/fire cycle allocates nothing.
+ */
+
+/**
+ * Seconds -> integer milliseconds exactly as the lamp verbs do: Math.trunc(seconds * 1000), with a 1e-6 ms guard so that values such as 0.57 s
+ * (569.9999999999999 in floating point) do not lose a whole millisecond. Non-positive and non-finite input gives 0.
+ * @param {number} seconds
+ * @returns {number}
+ */
+export function secondsToMs(seconds) {
+  if (!(seconds > 0) || !Number.isFinite(seconds)) return 0;
+  return Math.trunc(seconds * 1000 + 1e-6);
+}
+
+/**
+ * Seconds -> a timer delay in ms for a verb that takes a positive duration: 0 means "none" (t <= 0), any positive duration is at least 1 ms so that a
+ * tiny positive time can never be mistaken for the "indefinite" value 0.
+ * @param {number} seconds
+ * @returns {number}
+ */
+export function timeoutMs(seconds) {
+  if (!(seconds > 0)) return 0;
+  const ms = secondsToMs(seconds);
+  return ms > 0 ? ms : 1;
+}
+
+/** @typedef {{id:number, time:number, prio:number, seq:number, fn:(null|(()=>void))}} TimerRec */
+
+export class TimerWheel {
+  constructor() {
+    this._now = 0;
+    this._nextId = 1;
+    this._seq = 0;
+    /** @type {TimerRec[]} binary min-heap ordered by (time, prio, seq); cancelled records stay until they reach the top (fn === null) */
+    this._heap = [];
+    /** @type {Map<number, TimerRec>} live timers by id */
+    this._live = new Map();
+    /** @type {TimerRec[]} recycled records */
+    this._pool = [];
+    this._running = false;
+    this._target = 0;
+  }
+
+  /**
+   * Schedule `fn` to run `ms` milliseconds from now().
+   * @param {number} ms delay (truncated; <= 0 or NaN = 0)
+   * @param {() => void} fn
+   * @param {number} [priority] ties at the same millisecond fire by ascending priority, then insertion order (default 0)
+   * @returns {number} id (> 0)
+   */
+  schedule(ms, fn, priority = 0) {
+    if (typeof fn !== 'function') throw new TypeError('TimerWheel.schedule: fn must be a function');
+    const delay = ms > 0 && Number.isFinite(ms) ? Math.trunc(ms) : 0;
+    const rec = this._pool.pop() || { id: 0, time: 0, prio: 0, seq: 0, fn: null };
+    rec.id = this._nextId++;
+    rec.time = this._now + delay;
+    rec.prio = priority;
+    rec.seq = this._seq++;
+    rec.fn = fn;
+    this._live.set(rec.id, rec);
+    this._push(rec);
+    return rec.id;
+  }
+
+  /**
+   * Cancel a pending timer. Unknown / already fired / already cancelled ids (and 0) are ignored.
+   * @param {number} id
+   */
+  cancel(id) {
+    if (!id) return;
+    const rec = this._live.get(id);
+    if (!rec) return;
+    this._live.delete(id);
+    rec.fn = null;
+  }
+
+  /**
+   * Move time forward by `ms` whole milliseconds, firing every timer that falls due, one at a time, in (time, priority, insertion) order.
+   * @param {number} ms
+   */
+  advance(ms) {
+    if (!(ms > 0) || !Number.isFinite(ms)) return;
+    const whole = Math.trunc(ms);
+    if (whole <= 0) return;
+    if (this._running) { this._target += whole; return; }
+    this._running = true;
+    this._target = this._now + whole;
+    try {
+      for (;;) {
+        const rec = this._heap[0];
+        if (rec === undefined) break;
+        if (rec.fn === null) { this._pop(); this._pool.push(rec); continue; }
+        if (rec.time > this._target) break;
+        this._pop();
+        const fn = rec.fn;
+        const time = rec.time;
+        this._live.delete(rec.id);
+        rec.fn = null;
+        this._pool.push(rec);
+        if (time > this._now) this._now = time;
+        fn();
+      }
+      this._now = this._target;
+    } finally {
+      this._running = false;
+    }
+  }
+
+  /** @returns {number} milliseconds elapsed (inside a callback: the due time of the firing timer) */
+  now() { return this._now; }
+
+  /** @returns {number} number of pending (live) timers */
+  size() { return this._live.size; }
+
+  /** Cancel every pending timer (time is kept). */
+  clear() {
+    for (const rec of this._live.values()) rec.fn = null;
+    this._live.clear();
+  }
+
+  // ---- binary heap -------------------------------------------------------------------------------------------------------------------------
+  /** @param {TimerRec} a @param {TimerRec} b */
+  static _less(a, b) {
+    if (a.time !== b.time) return a.time < b.time;
+    if (a.prio !== b.prio) return a.prio < b.prio;
+    return a.seq < b.seq;
+  }
+
+  /** @param {TimerRec} rec */
+  _push(rec) {
+    const h = this._heap;
+    let i = h.length;
+    h.push(rec);
+    while (i > 0) {
+      const p = (i - 1) >> 1;
+      if (!TimerWheel._less(rec, h[p])) break;
+      h[i] = h[p];
+      i = p;
+    }
+    h[i] = rec;
+  }
+
+  _pop() {
+    const h = this._heap;
+    const last = h.pop();
+    if (h.length === 0 || last === undefined) return;
+    let i = 0;
+    const n = h.length;
+    for (;;) {
+      let c = 2 * i + 1;
+      if (c >= n) break;
+      if (c + 1 < n && TimerWheel._less(h[c + 1], h[c])) c++;
+      if (!TimerWheel._less(h[c], last)) break;
+      h[i] = h[c];
+      i = c;
+    }
+    h[i] = last;
+  }
+}
diff --git a/public/games/space-cadet/src/main.js b/public/games/space-cadet/src/main.js
new file mode 100644
index 0000000..bf6f96f
--- /dev/null
+++ b/public/games/space-cadet/src/main.js
@@ -0,0 +1,504 @@
+/**
+ * src/main.js
+ * OWNER: INTEGRATOR
+ * STATUS: IMPLEMENTED
+ * CONTRACT: ARCHITECTURE.md 12 (main loop, pause, demo, start flow, debug handle), 8.1 (DOM mount points), 8.9 (UIActions), 10.6 (sound start flow),
+ *           11 (input routing)
+ *
+ * The ONLY module that knows every other module.  Browser entry point (loaded by index.html as <script type="module">).  Builds the services
+ * (store, audio, game, art, UI, input, renderer), connects them and runs the animation loop:
+ *   input (DOM handlers, between frames) -> game.advance(frameDt) [physics@120Hz -> rules events -> rules timers -> lamps]
+ *   -> audio.update -> renderer.render(game.buildRenderFrame) -> ui.update.
+ * The only global is window.__pinball = { game, physics, lamps, rules, audio, ui, renderer, input, data, store, art, actions, cinematic } (debugging only).
+ *
+ * URL flags: ?demo ?seed=<int> ?camera=original|top|orbit ?cinematic=1|0 ?nosound ?quality=low|high ?touch=1 ?debug=1
+ *
+ * Cinematic camera (Options > Cinematic Camera, key C): the director (render/cinematic.js) watches the physics events through game's
+ * onPhysicsEvents observer and the render frame; its timeScale() slows the NEXT frame's simulation (game.advance(dt * scale), 70 % during a
+ * shot) and its state rides on the render frame (frame.cinematic) to the camera. Mouse view (Options > Mouse Rotates View, on by default): the
+ * renderer turns the original camera with the mouse and the mouse buttons stop working the flippers (input.setMouseButtons(false)); touch is
+ * unchanged and debug mode keeps the mouse for dragging the ball.
+ *
+ * Structure: createApp(env) is the whole shell and touches the page ONLY through `env` (document, window, location.search, clock, rAF,
+ * renderer loader), so tests/integration_app.test.mjs can run it in Node on a fake DOM; the last lines call it with the real page when a
+ * `document` exists (importing this file in Node does nothing).
+ *
+ * ASSUMPTIONS (gap protocol):
+ *  - The renderer module (and with it three.js from the CDN) is imported dynamically.  The page, menus, panel, start card and the sim come up
+ *    first; if the CDN is unreachable the table area shows a message instead of killing the whole page.
+ *  - Game keys are blocked (input.setBlocked) while the start card, a menu or a dialog is open.  Opening a menu or a dialog during a running
+ *    non-demo game pauses it; closing the last one resumes it, but only if that open caused the pause.
+ *  - Window blur pauses a running game (not the demo); a hidden tab pauses everything.  Focus never resumes a game by itself (F3 / Resume
+ *    button); only the attract mode (demo) that a hidden tab paused carries on when the tab returns.
+ *  - Choosing New Game / a player count / Launch from the menu while the start card is still up behaves like "Start without sound" unless the
+ *    sound consent was already granted.  Switching Sounds ON (menu / F5) or loading own files counts as consent and starts the load.
+ *  - ?demo with a remembered sound consent loads the files at once but creates the AudioContext only at the first click / key / touch (the
+ *    browser refuses to start one earlier and a context created blindly would stay silent).
+ *  - Coarse-pointer (touch) devices cap the device pixel ratio at 1.5.
+ *  - An exception in one stage of a frame (simulation, audio, render, UI, shell) is reported (at most 5 times per stage) and does not stop the
+ *    other stages or the loop, so a failing renderer never freezes the scoreboard and menus and dialogs stay usable.
+ *  - The folder picker of the Audio facade (showDirectoryPicker) is not wired: the UI's own "Load My Sounds" inputs (folder / zip) and drag and drop cover it.
+ */
+import * as data from './data/index.js';
+import { createGame } from './game.js';
+import { createInput } from './input.js';
+import { createAudio } from './audio.js';
+import { paintAll } from './render/art/index.js';
+import { mulberry32 } from './render/art/rng.js';
+import { createUI } from './ui/index.js';
+import { createStore } from './ui/storage.js';
+import { createCinematicDirector } from './render/cinematic.js';
+
+/** At most this many console errors per frame stage (a persistent fault must not flood the console 60 times a second). */
+const ERROR_LOG_LIMIT = 5;
+
+/** Minimal Renderer stand-in used until (or instead of) the real one: shows a message on a 2D canvas, never throws. */
+function createMessageRenderer(doc, message) {
+  const canvas = doc.createElement('canvas');
+  let mode = 'original';
+  const paint = () => {
+    const w = canvas.width = Math.max(1, canvas.clientWidth || 365);
+    const h = canvas.height = Math.max(1, canvas.clientHeight || 416);
+    const g = canvas.getContext('2d');
+    if (!g) return;
+    g.fillStyle = '#05050c'; g.fillRect(0, 0, w, h);
+    g.fillStyle = '#c9c9d8'; g.textAlign = 'center';
+    g.font = `${Math.max(12, Math.round(w / 20))}px system-ui, sans-serif`;
+    const lines = String(message).split('\n');
+    lines.forEach((line, i) => g.fillText(line, w / 2, h / 2 + (i - (lines.length - 1) / 2) * Math.max(16, Math.round(w / 15))));
+  };
+  return {
+    domElement: canvas,
+    resize() { paint(); },
+    render() {},
+    setCameraMode(m) { mode = m; },
+    getCameraMode: () => mode,
+    cycleCameraMode() { return mode; },
+    pickTable: () => null,
+    setQuality() {},
+    info: () => ({ drawCalls: 0, triangles: 0, textures: 0 }),
+    dispose() {},
+  };
+}
+
+/** Last-resort error display (the page must never stay blank without telling the visitor why). */
+function showFatal(err) {
+  console.error(err);
+  const host = document.getElementById('stage') || document.body;
+  const box = document.createElement('div');
+  box.setAttribute('role', 'alert');
+  box.style.cssText = 'position:absolute;inset:0;z-index:60;display:grid;place-items:center;padding:16px;background:#000c;color:#f0c8c8;text-align:center;font:14px system-ui,sans-serif';
+  box.textContent = 'Star Cadet could not start: ' + (err && err.message ? err.message : String(err));
+  host.appendChild(box);
+}
+
+/**
+ * Build the whole application on a page.
+ * @param {{
+ *   doc: any, win: any,                                             the document and window (or fakes with the same members)
+ *   search?: string,                                                location.search
+ *   coarse?: boolean,                                               matchMedia('(pointer: coarse)').matches
+ *   now?: () => number, raf?: (cb: (t: number) => void) => any,     clock (ms) and requestAnimationFrame
+ *   ResizeObserver?: any,                                           observer class (optional)
+ *   importRenderer?: () => Promise<{createRenderer: Function}>,     loader of src/render/index.js (default: dynamic import)
+ *   createArt?: (opts: object) => any,                              default: paintAll(data, opts)
+ *   store?: any, audio?: any,                                       service doubles (tests)
+ * }} env
+ */
+export function createApp(env) {
+  const { doc, win } = env;
+  const q = new URLSearchParams(env.search || '');
+  const coarse = Boolean(env.coarse);
+  const now = env.now || (() => (typeof performance !== 'undefined' ? performance.now() : 0));
+  const raf = env.raf || ((cb) => requestAnimationFrame(cb));
+  const store = env.store || createStore();
+  let options = store.getOptions();
+  if (q.get('camera')) options = store.setOptions({ camera: /** @type {any} */ (q.get('camera')) });
+  if (q.has('cinematic')) options = store.setOptions({ cinematic: q.get('cinematic') !== '0' });
+  if (q.has('nosound')) options = store.setOptions({ sounds: false, soundConsent: 'denied' });
+  const seed = q.get('seed');
+  const rand = seed !== null && seed !== '' && Number.isFinite(Number(seed)) ? mulberry32(Number(seed)) : Math.random;
+  const qualityFlag = q.get('quality');
+
+  // ---- services -----------------------------------------------------------------------------------------------------------------------
+  const audio = env.audio || createAudio();
+  /** false after "Start without sound" (or ?nosound): then the page never touches the audio hardware or the network for sound */
+  const wantsSound = () => options.sounds && options.soundConsent !== 'denied';
+  audio.setEnabled(wantsSound());
+  audio.setVolume(options.volume);
+  const director = createCinematicDirector();
+  /** The cinematic camera needs a perspective camera: the orthographic Top view keeps it (and its slow motion) off. */
+  const syncDirector = () => director.setEnabled(Boolean(options.cinematic) && options.camera !== 'top');
+  syncDirector();
+  const game = createGame({ sound: audio, rand, onPhysicsEvents: (events) => director.onPhysicsEvents(events) });
+  const rules = game.rules;
+  const savedScores = store.getHighScores();
+  if (savedScores) rules.highScores.load(savedScores);
+  rules.highScores.onChange = (entries) => store.setHighScores(entries);
+
+  const artOpts = {
+    createCanvas: (w, h) => Object.assign(doc.createElement('canvas'), { width: w, height: h }),
+    quality: qualityFlag === 'low' ? 'low' : qualityFlag === 'high' ? 'high' : 'normal',
+  };
+  const art = env.createArt ? env.createArt(artOpts) : paintAll(data, artOpts);
+
+  // ---- shared state of the shell --------------------------------------------------------------------------------------------------------
+  /** @type {import('./types.js').Renderer} */
+  let renderer = createMessageRenderer(doc, 'Loading the table...');
+  let ui = /** @type {import('./types.js').UI} */ (/** @type {any} */ (null));
+  let input = /** @type {import('./types.js').Input} */ (/** @type {any} */ (null));
+  let showFps = false;
+  let wasDebug = false;
+  const view = () => rules.getView();
+  /** Keep the input's debug flag equal to the rules' one (the typed cheat 'hidden test' toggles it inside the rules). */
+  const syncDebug = () => {
+    const d = Boolean(view().debug);
+    if (d === wasDebug) return;
+    wasDebug = d;
+    input.setDebug(d);
+    applyMouseMode();
+    if (!d && showFps) { showFps = false; ui.setFps(null); }
+  };
+  /** The mouse turns the view (Mouse Rotates View, not while debug mode drags the ball) or works the flippers. */
+  function applyMouseMode() {
+    if (typeof renderer.setMouseLook === 'function') renderer.setMouseLook(Boolean(options.mouseLook) && !view().debug);
+    if (input && typeof input.setMouseButtons === 'function') input.setMouseButtons(!options.mouseLook);
+  }
+  const inGame = () => view().phase === 'lightShow' || view().phase === 'playing';
+  const startEl = () => doc.getElementById('start-overlay');
+  const overlayShown = () => { const el = startEl(); return Boolean(el && !el.hidden); };
+  const setOpts = (patch) => { options = store.setOptions(patch); if (ui) ui.setOptions(options); return options; };
+  const showStart = () => ui.showStartOverlay({ soundStatus: audio.getStatus() });
+
+  // ---- blocking and auto pause ----------------------------------------------------------------------------------------------------------
+  const open = { dialog: false, menu: false };
+  let lastBlocked = false;
+  const syncBlocked = () => {
+    if (!input) return;                                            // the UI may report an open dialog while it is still being built
+    const b = open.dialog || open.menu || overlayShown();
+    if (b !== lastBlocked) { lastBlocked = b; input.setBlocked(b); }
+  };
+  let autoPaused = false;
+  /** A hidden tab paused the attract mode (not a human game): it carries on when the tab is visible again. */
+  let hiddenDemoPause = false;
+  function setPaused(on) {
+    game.setPaused(on);
+    audio.setPaused(on);
+  }
+  function syncAutoPause() {
+    const want = open.dialog || open.menu;
+    if (want && !autoPaused && inGame() && !view().demo && !game.isPaused()) { autoPaused = true; setPaused(true); }
+    else if (!want && autoPaused) { autoPaused = false; setPaused(false); }
+  }
+  function clearPause() {
+    autoPaused = false;
+    hiddenDemoPause = false;
+    if (game.isPaused()) setPaused(false);
+  }
+
+  // ---- UI actions (UI -> application) ---------------------------------------------------------------------------------------------------
+  const consented = () => options.soundConsent === 'granted' && options.sounds;
+  function requestSounds() {
+    audio.unlock();                                                // synchronous: the caller runs inside a user gesture
+    audio.setEnabled(true);
+    return audio.load().then((s) => { ui.setSoundStatus(s); return s; });
+  }
+  /** ?demo with a remembered consent: fetch now, create the AudioContext at the first gesture (see the header). */
+  function requestSoundsQuietly() {
+    audio.setEnabled(true);
+    audio.unlockOnGesture();
+    return audio.load().then((s) => { ui.setSoundStatus(s); return s; });
+  }
+  function startMusicIfWanted() {
+    if (options.music) { audio.music.setEnabled(true).catch(() => {}); if (typeof audio.music.restart === 'function') audio.music.restart(); }
+  }
+  /** Begin a game from the start card's defaults (menu commands used while the card is still up). */
+  function ensureStarted() {
+    if (!overlayShown()) return false;
+    actions.start({ withSound: consented(), players: options.players, music: consented() && options.music });
+    return true;
+  }
+
+  /** What an import of the user's own files (picker or drop) did, in words. @param {{matched:number, accepted:number, rejected:number, music:boolean}} r */
+  function importMessage(r) {
+    if (r.accepted > 0) return `Loaded ${r.accepted} sound file${r.accepted === 1 ? '' : 's'} from your files.`;
+    if (r.music) return 'Loaded the music file from your files.';
+    if (r.rejected > 0) return 'Those files do not match the original game sounds (another version, or damaged), so they were not used.';
+    if (r.matched > 0) return 'Those sound files are already loaded.';
+    return 'No matching Pinball sound files were found in your selection.';
+  }
+  /** After an import: show the status and, when something usable arrived, switch sounds on (the user obviously wants to hear it). */
+  function afterImport(status) {
+    ui.setSoundStatus(status);
+    const r = audio.getLastImport();
+    if (r.accepted > 0 || r.music) { setOpts({ sounds: true, soundConsent: 'granted' }); audio.setEnabled(true); audio.unlock(); }
+    ui.toast(importMessage(r), 3500);
+  }
+
+  /** @type {import('./types.js').UIActions} */
+  const actions = {
+    start({ withSound, players, music }) {
+      setOpts({ players: /** @type {any} */ (players), sounds: withSound, music: withSound && music, soundConsent: withSound ? 'granted' : 'denied' });
+      audio.setEnabled(withSound);
+      if (withSound) audio.unlock();                               // synchronously inside the click (user gesture); a silent start creates no context
+      if (withSound) audio.load().then((s) => ui.setSoundStatus(s));
+      if (withSound && music) audio.music.setEnabled(true).catch(() => {});
+      ui.hideStartOverlay();
+      syncBlocked();
+      clearPause();
+      director.reset();
+      rules.newGame({ players });
+    },
+    newGame() {
+      if (ensureStarted()) return;
+      clearPause();
+      startMusicIfWanted();
+      director.reset();
+      rules.newGame({ players: options.players });
+    },
+    launchBall() { if (!overlayShown()) rules.launchBall(); },
+    togglePause() {
+      if (view().phase === 'idle' || overlayShown()) return;
+      autoPaused = false;
+      hiddenDemoPause = false;
+      setPaused(!game.isPaused());
+    },
+    toggleDemo() {
+      if (wantsSound()) audio.unlock();
+      if (overlayShown()) { ui.hideStartOverlay(); syncBlocked(); }
+      clearPause();
+      director.reset();
+      const turnOn = !view().demo;
+      rules.setDemo(turnOn);
+      if (turnOn) startMusicIfWanted();
+    },
+    showHighScores() { ui.showHighScores(rules.highScores.entries(), { clearable: true }); },
+    exit() {
+      clearPause();
+      audio.stopAll();
+      audio.music.stop();                                          // the start card is not a game: no music behind it
+      director.reset();
+      rules.stopGame();
+      showStart();
+      syncBlocked();
+    },
+    selectPlayers(n) {
+      setOpts({ players: /** @type {any} */ (n) });
+      if (ensureStarted()) return;
+      clearPause();
+      rules.newGame({ players: n });
+    },
+    setSounds(on) {
+      setOpts({ sounds: on, ...(on ? { soundConsent: /** @type {any} */ ('granted') } : {}) });
+      audio.setEnabled(on);
+      if (on) {
+        const st = audio.getStatus().state;
+        if (st === 'idle' || st === 'unavailable') { ui.toast('Loading the original sounds...'); requestSounds(); } else audio.unlock();
+      }
+    },
+    setMusic(on) {
+      setOpts({ music: on });
+      audio.unlock();
+      audio.music.setEnabled(on).then(() => {
+        if (on && !audio.music.available()) ui.toast('Music not available: put PINBALL.MID into sounds/ or load your own files.', 4000);
+      }).catch(() => {});
+    },
+    setVolume(v) { audio.setVolume(v); setOpts({ volume: v }); },
+    toggleFullscreen() {
+      const unavailable = () => ui.toast('Full screen is not available here.');
+      try {
+        if (doc.fullscreenElement) { const r = doc.exitFullscreen?.(); if (r && r.catch) r.catch(() => {}); return; }
+        const el = doc.documentElement;
+        if (!el || typeof el.requestFullscreen !== 'function') { unavailable(); return; }   // e.g. iPhone Safari: say so instead of doing nothing
+        const r = el.requestFullscreen();
+        if (r && r.catch) r.catch(unavailable);
+      } catch { unavailable(); }
+    },
+    setCamera(m) { renderer.setCameraMode(m); input.setPointerFlippers(m !== 'orbit'); setOpts({ camera: m }); syncDirector(); },
+    setCinematic(on) {
+      setOpts({ cinematic: Boolean(on) });
+      syncDirector();
+      const top = options.camera === 'top';
+      ui.toast(on ? (top ? 'Cinematic camera ON (not in the Top view: switch the camera with V).' : 'Cinematic camera ON: a flipper hit follows the ball in slow motion.') : 'Cinematic camera OFF', 2500);
+    },
+    setMouseLook(on) { setOpts({ mouseLook: Boolean(on) }); applyMouseMode(); },
+    resetView() { if (typeof renderer.resetView === 'function') renderer.resetView(); },
+    submitName(name) { rules.submitName(name); },
+    clearHighScores() { rules.highScores.clear(); },
+    setBindings(b) { input.setBindings(b); store.setBindings(input.getBindings()); },
+    resetBindings() { const b = input.defaultBindings(); input.setBindings(b); store.setBindings(b); },
+    loadLocalSounds(files) {
+      audio.unlock();                                              // inside the picker gesture
+      audio.loadFromFiles(files).then(afterImport);
+    },
+  };
+
+  const bindings = store.getBindings() || { ...data.DEFAULT_KEYS };
+  ui = createUI({
+    root: doc.getElementById('app') || doc.body, doc, store, actions, panelArt: art.panel, options, bindings,
+    onDialogChange(o) { open.dialog = o; syncBlocked(); syncAutoPause(); },
+    onMenuChange(o) { open.menu = o; syncBlocked(); syncAutoPause(); },
+  });
+  audio.onStatus((s) => ui.setSoundStatus(s));
+  ui.setSoundStatus(audio.getStatus());
+  audio.attachDropTarget(doc, afterImport);                         // a Pinball folder / zip dropped anywhere on the page
+
+  // ---- input routing ------------------------------------------------------------------------------------------------------------------
+  const APP = {
+    newGame: actions.newGame, launchBall: actions.launchBall, pause: actions.togglePause, fullscreen: actions.toggleFullscreen,
+    sounds: () => actions.setSounds(!options.sounds), music: () => actions.setMusic(!options.music),
+    controls: () => ui.showControls(input.getBindings()), help: () => ui.showHelp(), camera: () => actions.setCamera(renderer.cycleCameraMode()),
+    cinematic: () => actions.setCinematic(!options.cinematic),
+  };
+  input = createInput({
+    bindings, target: win, doc,
+    onFocusLoss: () => rules.focusLost(),
+    onEvent(e) {
+      switch (e.kind) {
+        case 'game': rules.input(e.action, e.down); break;
+        case 'app': { const fn = APP[e.action]; if (fn) fn(); break; }
+        case 'cheat': rules.cheat(e.word); syncDebug(); break;
+        case 'debug':
+          if (e.key === 'Y') { showFps = !showFps; if (!showFps) ui.setFps(null); } else rules.debugKey(/** @type {any} */ (e.key));
+          break;
+        case 'pointer': {
+          if (e.phase === 'up') { game.physics.debugRelease(); break; }
+          const p = renderer.pickTable(e.clientX, e.clientY);
+          if (!p) break;
+          if (e.phase === 'down') game.physics.debugGrab(p[0], p[1]); else game.physics.debugDrag(p[0], p[1]);
+          break;
+        }
+        default: break;
+      }
+    },
+  });
+  input.attach();
+  input.setPointerFlippers(options.camera !== 'orbit');
+  applyMouseMode();
+  syncBlocked();
+
+  // ---- focus: pause instead of letting the ball drain behind the user's back --------------------------------------------------------------
+  function onFocusLost(hidden) {
+    rules.focusLost();                 // first: a pulled plunger goes back without firing, so the key-up that releaseAll() sends has nothing left to launch
+    input.releaseAll();
+    if (view().phase === 'idle' || overlayShown()) return;
+    if (hidden || !view().demo) {
+      autoPaused = false;
+      if (hidden && view().demo && !game.isPaused()) hiddenDemoPause = true;
+      setPaused(true);
+    }
+  }
+  function onFocusGained() {
+    rules.focusGained();
+    if (hiddenDemoPause) {
+      hiddenDemoPause = false;
+      if (game.isPaused() && view().demo) setPaused(false);
+    }
+  }
+  win.addEventListener('blur', () => onFocusLost(false));
+  doc.addEventListener('visibilitychange', () => { if (doc.hidden) onFocusLost(true); else onFocusGained(); });
+  doc.addEventListener('fullscreenchange', () => setOpts({ fullscreen: Boolean(doc.fullscreenElement) }));
+
+  // ---- the renderer (three.js is loaded from the CDN; failure leaves the rest of the page working) ----------------------------------------
+  const tableView = doc.getElementById('table-view');
+  const mount = (r) => {
+    if (tableView && r.domElement) tableView.appendChild(r.domElement);
+  };
+  const unmount = (r) => {
+    if (r.domElement && r.domElement.parentNode) r.domElement.parentNode.removeChild(r.domElement);
+  };
+  mount(renderer);
+  const resize = () => {
+    if (!tableView) return;
+    const r = tableView.getBoundingClientRect();
+    renderer.resize(Math.max(1, Math.round(r.width)), Math.max(1, Math.round(r.height)), win.devicePixelRatio || 1);
+  };
+  const ResizeObserverCtor = env.ResizeObserver;
+  if (typeof ResizeObserverCtor === 'function' && tableView) new ResizeObserverCtor(resize).observe(tableView);
+  win.addEventListener('resize', resize);
+  resize();
+  const importRenderer = env.importRenderer || (() => import('./render/index.js'));
+  const rendererReady = (async () => {
+    try {
+      const { createRenderer } = await importRenderer();
+      const quality = qualityFlag === 'low' ? { shadows: false, bloom: false, dprMax: 1.5 } : qualityFlag === 'high' ? { shadows: true, bloom: true, dprMax: 3 } : { dprMax: coarse ? 1.5 : 2 };
+      const real = createRenderer({ data, art, quality });
+      unmount(renderer);
+      renderer.dispose();
+      renderer = real;
+      mount(renderer);
+      renderer.setCameraMode(options.camera);
+      applyMouseMode();
+      resize();
+    } catch (err) {
+      console.error('[main] the 3D renderer could not be loaded', err);
+      unmount(renderer);
+      renderer = createMessageRenderer(doc, 'The 3D table could not be loaded.\nCheck your internet connection (three.js\nis fetched from a CDN) and reload.');
+      mount(renderer);
+      resize();
+    }
+    if (win.__pinball) win.__pinball.renderer = renderer;
+  })();
+
+  // ---- the loop ---------------------------------------------------------------------------------------------------------------------------
+  let last = now();
+  let fpsFrames = 0;
+  let fpsT = 0;
+  /** @type {Record<string, number>} errors seen per stage */
+  const errors = {};
+  function fail(stage, err) {
+    errors[stage] = (errors[stage] || 0) + 1;
+    if (errors[stage] <= ERROR_LOG_LIMIT) console.error(`[main] ${stage} error`, err);
+  }
+  /** One animation frame; every stage is isolated, so one broken stage never freezes the others. @param {number} t DOMHighResTimeStamp (ms) */
+  function frame(t) {
+    raf(frame);
+    let dt = (t - last) / 1000;
+    if (!(dt > 0)) dt = 0;
+    else if (dt > data.PHYS.maxFrameDt) dt = data.PHYS.maxFrameDt;
+    last = t;
+    try { game.advance(dt * director.timeScale()); } catch (err) { fail('simulation', err); }   // physics@120Hz -> rules events -> rules timers -> lamps (slow motion during a cinematic shot)
+    try { audio.update(dt); } catch (err) { fail('audio', err); }
+    try {
+      const rf = game.buildRenderFrame(dt);
+      const v = view();
+      director.update({ balls: rf.physics ? rf.physics.balls : [], time: rf.time, score: v.score, player: v.player, playing: v.phase === 'playing', tilted: v.tilted, paused: game.isPaused() }, dt);
+      rf.cinematic = director.state;
+      renderer.render(rf);
+    } catch (err) { fail('render', err); }
+    try { ui.update(view(), dt); syncDebug(); } catch (err) { fail('ui', err); }
+    try {
+      syncBlocked();
+      if (showFps) { fpsFrames++; fpsT += dt; if (fpsT >= 0.5) { ui.setFps(Math.round(fpsFrames / fpsT)); fpsFrames = 0; fpsT = 0; } }
+    } catch (err) { fail('shell', err); }
+  }
+  raf(frame);
+
+  /** The single allowed global (debugging only; nothing reads it). */
+  win.__pinball = { game, physics: game.physics, lamps: game.lamps, rules, audio, ui, renderer, input, data, store, art, actions, cinematic: director };
+
+  setOpts({});
+  if (q.get('debug') === '1') { rules.setDebug(true); syncDebug(); }
+  if (q.has('demo')) {
+    if (consented()) { requestSoundsQuietly(); startMusicIfWanted(); }
+    rules.setDemo(true);
+  } else {
+    showStart();
+    syncBlocked();
+  }
+
+  return { game, rules, audio, ui, input, store, art, actions, frame, getRenderer: () => renderer, rendererReady, errors, director };
+}
+
+// ---- browser entry (importing this module in Node, where there is no document, only defines createApp) ----------------------------------------
+if (typeof document !== 'undefined' && typeof window !== 'undefined') {
+  try {
+    createApp({
+      doc: document, win: window, search: location.search,
+      coarse: typeof matchMedia === 'function' && matchMedia('(pointer: coarse)').matches,
+      now: () => performance.now(), raf: (cb) => requestAnimationFrame(cb), ResizeObserver: window.ResizeObserver,
+    });
+  } catch (err) {
+    showFatal(err);
+  }
+}
