+				const halfFovH = Math.atan( ( this.camera.aspect ) * Math.tan( halfFovV ) );
+
+				maxLength = Math.tan( Math.max( halfFovV, halfFovH ) ) * distance * 2;
+				tick = maxLength / 20;
+
+				size = maxLength * multiplier;
+				divisions = size / tick;
