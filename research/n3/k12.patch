+			newNode.onerror	= function () {
+				console.log(
+					'SRI fallback ' +
+					fallback +
+					' also failed to match integrity string ' +
+					newNode.integrity +
+					'.'
+				);
+			};
+
+			document.head.appendChild(newNode);
+		};
+	}
+}
