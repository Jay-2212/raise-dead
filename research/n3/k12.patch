+/** Yellow/black diagonal hazard band, clipped to the rectangle x0..x0+w (T-frame x increases to the screen LEFT) y0..y0+h. */
+function hazardBand(ctx, x0, y0, w, h, ang) {
+  ctx.save();
+  ctx.beginPath();
+  ctx.rect(x0, y0, w, h);
+  ctx.clip();
