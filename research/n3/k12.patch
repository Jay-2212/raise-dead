+      <table>
+        <thead>
+          <tr>
+            <th>Mouse button</th>
+            <th>Action</th>
+          </tr>
+        </thead>
+        <tbody>
+          <tr class="normal-controls-enabled">
+            <td>Primary</td>
+            <td>Change view</td>
