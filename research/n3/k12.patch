+  /** Sound key table for the hyperspace chute when none of the reflex flags is lit: by the lit-lamp count BEFORE the hit. */
+  const HYPER_SOUND = { 1: 'SW36', 2: 'SW35', 3: 'SW38', 4: 'SW39' };
