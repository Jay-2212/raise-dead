+    ctx.save();
+    ctx.shadowColor = 'rgba(3,4,15,0.7)';
+    ctx.shadowBlur = 0.25 * px;
+    ctx.beginPath();
+    polyPath(ctx, body, true);
+    ctx.fillStyle = PALETTE.rocketRed;
+    ctx.fill();
+    ctx.restore();
+    ctx.shadowColor = 'rgba(0,0,0,0)';
+    ctx.shadowBlur = 0;
+    ctx.save();
+    ctx.beginPath();
+    polyPath(ctx, body, true);
+    ctx.clip();
