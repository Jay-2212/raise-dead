+        if (raw <= 0) { out.z = 0; out.gx = 0; out.gy = 0; } else if (raw >= deckZ) { out.z = deckZ; out.gx = 0; out.gy = 0; } else { out.z = raw; out.gx = p.a; out.gy = p.b; }
