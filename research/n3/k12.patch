+  // ---------------------------------------------------------------------------------------------------------------------------------
+  // Hooks (SPEC 5.13.1): lamp timers and group decay timers
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  lamps.onLampTimer('lite17', () => {                       // extra-ball lamps: after 55 s both flash 5 s
+    if (!s.ebPending) return;
+    s.ebPending = false;
+    lamps.flash('lite17', TIMING.extraBallFlash);
+    lamps.flash('lite18', TIMING.extraBallFlash);
+  });
+  lamps.onLampTimer('lite59', () => { s.bonusFlag = false; });
+  lamps.onLampTimer('lite60', () => { s.jackpotFlag = false; });
+  lamps.onLampTimer('lite200', () => {                      // ball save: 5 s steady, then 5 s flashing, then off
+    if (lamps.getField('lite200') === 0) {
+      lamps.flashThenOff('lite200', TIMING.ballSaveFlash);
+      lamps.setField('lite200', 1);
+    } else {
+      lamps.setField('lite200', 0);
+    }
+  });
+
+  G.hyperspace_lights.onNotifyExpired(() => {
+    G.hyperspace_lights.dropTop();
+    if (G.hyperspace_lights.count() > 0) G.hyperspace_lights.restartNotifyTimer(TIMING.hyperspaceDecay);
+  });
+  G.bumper_target_lights.onNotifyExpired(() => {
+    G.bumper_target_lights.dropTop();
+    if (G.bumper_target_lights.count() > 0) G.bumper_target_lights.restartNotifyTimer(TIMING.medalDecay);
+  });
+  G.top_target_lights.onNotifyExpired(() => {
+    s.mult = Math.max(0, s.mult - 1);
+    G.top_target_lights.dropTop();
+    if (G.top_target_lights.count() > 0) G.top_target_lights.restartNotifyTimer(TIMING.multiplierDecay);
+  });
+
+  R.feat = {
+    bumperHit, rebounderHit, popupHit, soloHit, rolloverEnter, tripwire, oneway, rampLine1, rampHoleReleased, kickoutCapture, sinkCapture,
+    flagFrame, flagLoop, kickbackTimerExpired, flipperExtend,
+    openGate, closeGate, startTrek, stopTrek, refuel, armGravityWell, setBumperLevel, raiseCentrePost, cancelCentrePost, lightExtraBall,
+    advanceDest, clearDest, setDest, destOf, grandReward, ballStartBlock, endOfBall, levelOf, reenableBank, reenableAll, flashSink,
+    sinkRim: SINK_RIM, sinkArrow: SINK_ARROW,
+  };
+}
diff --git a/public/games/space-cadet/src/rules/flow.js b/public/games/space-cadet/src/rules/flow.js
new file mode 100644
index 0000000..0e7f618
--- /dev/null
+++ b/public/games/space-cadet/src/rules/flow.js
@@ -0,0 +1,374 @@
+/**
+ * src/rules/flow.js
+ * OWNER: RULES
+ * STATUS: IMPLEMENTED
+ * CONTRACT: ARCHITECTURE.md 5.5 (sequences), 7.3, 7.8, 7.9; SPEC 5.2 (all), 4.11 (tilt consequences), 6.5 (input gating)
+ * Game flow: new game + light show, ball feed, drain / ball save / replay / extra ball / end-of-ball reset block, multiplayer turn change,
+ * tilt, game over + EndGame + name prompts + the mission-box cycle, pause, demo on/off, exit, input gating.
+ * Phases: idle -> lightShow -> playing -> gameOver (-> lightShow ...).  `gameOver` is entered when the last ball's 1.82 s drain timer ends
+ * (flippers disabled, nothing in play); the EndGame step 3.0 s later sets gameOverEnded ("F2 Starts New Game", name prompts, twinkle, cycle).
+ * ASSUMPTIONS: a drain with via 'forced' (the 30 s tilt timeout, tests) never uses the ball save / replay; a repeated `drain` with remaining 0
+ * while the drain timer runs is ignored; "Game Over" / "F2 Starts New Game" / "Game Paused"
+ * clear the info box first so they show at once; the demo restarts 5.0 s after the game-over step began; cheat `bmax` re-feeds the ball
+ * silently (no bonus, no ball lost) and clears itself at the next feed; the tilt text "TILT!" is removed again when the next ball is fed.
+ */
+
+/** @param {object} R rules context (state.js) */
+export function installFlow(R) {
+  const { physics, lamps, sched, D, s, G } = R;
+  const { INFO, TIMING, POTS, fmt } = D;
+  const T = D.MISSION_TEXT;
+
+  const playerText = (n) => fmt(s.demo ? INFO.demoPlayer : INFO.player, n);
+
+  function clearTimers() {
+    sched.cancelAll();
+    for (const k of Object.keys(s.h)) s.h[k] = null;
+  }
+
+  /** Everything a new game / exit / demo-off wipes (SPEC 5.2.1 step 1). */
+  function resetEverything() {
+    clearTimers();
+    R.infoBox.clear();
+    R.missionBox.clear();
+    s.paused = false; s.tilted = false; s.cheatsUsed = false; s.unlimited = false; s.easyMode = false;
+    s.ballInDrain = false; s.lastBall = false; s.gameOverEnded = false;
+    s.prompt = null; s.promptQueue.length = 0;
+    s.bonus = POTS.bonusNewGame; s.bonusFlag = false; s.jackpotFlag = false; s.reflex = 0; s.mult = 0;
+    s.attackLevel = 0; s.launchLevel = 0; s.ebPending = false; s.rankFlashPending = false;
+    for (const k of Object.keys(s.popDown)) s.popDown[k] = false;
+    R.resetPlayers();
+    R.m.reset();
+    R.demo.reset();
+    physics.removeAllBalls();
+    physics.resetTable();
+    physics.setFlippersEnabled(true);
+    physics.setDemoTriggers(s.demo);
+    lamps.resetAll();
+  }
+
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  // New game and the start-up light show (SPEC 5.2.1)
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  /** Starts a game with the current s.demo flag. F2 during the light show cuts it and starts ball 1 at once. */
+  function startNewGame(opts) {
+    const wasShow = s.phase === 'lightShow';
+    if (opts && opts.players !== undefined) R.setPlayerCount(opts.players);
+    resetEverything();
+    if (wasShow) { startGamePlayer1(); return; }
+    s.phase = 'lightShow';
+    G.all.lightShow(TIMING.lightShowStep);
+    const d = R.play('NEW_GAME');
+    R.startH('show', d > 0 ? d : TIMING.lightShowFallback, startGamePlayer1);
+  }
+
+  /** User-initiated new game (F2 / menu): leaves demo mode. */
+  function newGame(opts) {
+    s.demo = false;
+    startNewGame(opts);
+  }
+
+  /** End of the light show: the board goes dark, "Player 1" is shown and ball 1 is fed. */
+  function startGamePlayer1() {
+    s.h.show = null;
+    G.all.groupReset();
+    G.all.broadcast('off');
+    R.info(playerText(1), -1);
+    s.phase = 'playing';
+    feedBall();
+  }
+
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  // Ball feed (SPEC 5.2.2)
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  function feedBall() {
+    s.unlimited = false;
+    const resave = lamps.lightOn('lite200');                // a ball-save / replay relaunch keeps ALL table state
+    if (G.middle_circle.count() === 0) G.middle_circle.offsetForward();
+    if (!resave) R.feat.ballStartBlock();
+    lamps.setField('lite200', 0);
+    R.play('BALL_FEED');
+    if (resave) physics.relaunch(); else physics.startFeed({});
+  }
+
+  function onPlungerFed() {
+    if (s.tilted) {
+      s.tilted = false;
+      lamps.clearTiltLock();
+    }
+    if (R.infoBox.current() === INFO.tilt) R.infoBox.clear();
+    if (R.m.state === 0) R.msg(T.awaitingDeployment, -1); else R.m.showText();
+  }
+
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  // Drain, ball save, replay, extra ball, turn change (SPEC 5.2.4 - 5.2.6, 5.2.10)
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  function onDrain(e) {
+    const remaining = Number.isFinite(e.remaining) ? e.remaining : physics.ballsInPlay();
+    if (remaining > 0 || s.phase !== 'playing' || s.ballInDrain) return;
+    s.ballInDrain = true;
+    R.cancelH('tilt');
+    if (s.unlimited) {                                      // cheat bmax: the ball never drains
+      s.ballInDrain = false;
+      R.play('BALL_FEED');
+      physics.startFeed({});
+      return;
+    }
+    if (s.tilted || e.via === 'forced') {                   // no ball save / replay on a tilt (the 30 s timeout drains with via 'forced')
+      lamps.off('lite200');
+      lamps.off('lite199');
+    }
+    if (lamps.lightOn('lite200')) {                         // BALL SAVE
+      R.play('SW27');
+      lamps.on('lite200');
+      R.info(INFO.redeploy, -1);
+    } else if (lamps.lightOn('lite199')) {                  // REPLAY
+      R.play('SW27');
+      lamps.off('lite199');
+      lamps.on('lite200');
+      R.info(INFO.replayBall, 2);
+    } else {                                                // REAL end of ball
+      if (!s.tilted) {
+        R.play('SW27');                                     // SPEC 7.3: the drain sound also plays on an ordinary drain
+        R.specialAdd(s.bonus);
+        R.info(fmt(INFO.crashBonus, s.bonus), 2);
+      }
+      const P = R.P();
+      if (P.extraBalls > 0) {
+        P.extraBalls -= 1;
+        R.play('SW59');                                     // the shoot-again drain sound (file absent in the release: silent)
+        R.info(fmt(INFO.playerShootAgain, s.cur + 1), -1);
+      } else {
+        P.ballCount -= 1;
+        if (s.cur + 1 !== s.playerCount || P.ballCount !== 0) {
+          switchToNextPlayer();
+          s.lastBall = false;
+        } else {
+          s.lastBall = true;
+        }
+        lamps.setField('lite199', s.lastBall ? 1 : 0);
+      }
+      endOfBallReset();
+    }
+    R.startH('drain', TIMING.drainDelay, afterDrain);
+  }
+
+  function afterDrain() {
+    s.ballInDrain = false;
+    if (s.lastBall) gameOver(); else feedBall();
+  }
+
+  /** Hot-seat turn change: lamps are saved / restored per player and the reset block then runs on the INCOMING player's lamps. */
+  function switchToNextPlayer() {
+    if (s.playerCount < 2) return;
+    const outgoing = s.cur;
+    const incoming = (s.cur + 1) % s.playerCount;
+    lamps.playerChanged(outgoing, incoming);
+    s.cur = incoming;
+    R.info(playerText(incoming + 1), -1);
+  }
+
+  /** The end-of-ball reset block (SPEC 5.2.4). Rank lamps, lite58, lite199, lite200, lite84/85 and the 23 goal lamps are not in it. */
+  function endOfBallReset() {
+    for (const n of ['skill_shot_lights', 'l_trek_lights', 'r_trek_lights']) G[n].groupReset();
+    for (const n of ['bmpr_inc_lights', 'ramp_bmpr_inc_lights']) G[n].broadcast('off');
+    for (const l of ['lite30', 'lite29', 'lite1', 'lite54', 'lite55', 'lite56', 'lite17', 'lite18', 'lite27', 'lite28', 'lite16', 'lite20']) lamps.off(l);
+    G.hyperspace_lights.broadcast('off');
+    for (const l of ['lite25', 'lite26', 'lite130', 'lite19']) lamps.off(l);
+    for (const n of ['worm_hole_lights', 'bsink_arrow_lights', 'l_trek_lights', 'r_trek_lights']) G[n].broadcast('off');
+    for (const l of ['lite60', 'lite59', 'lite61']) lamps.off(l);
+    for (const n of ['bumper_target_lights', 'top_target_lights', 'top_circle_tgt_lights', 'ramp_tgt_lights', 'lchute_tgt_lights',
+      'bpr_solotgt_lights', 'skill_shot_lights']) G[n].broadcast('off');
+    for (const l of ['lite110', 'lite77', 'lite198', 'lite196', 'lite195']) lamps.off(l);
+    for (const m of lamps.fuel.members) lamps.off(m);
+    lamps.fuel.reset();                                     // fuel level 0
+    lamps.off('lite62');
+    R.feat.endOfBall();                                     // gravity well disarmed, gates re-closed, post removed, targets up, bumpers 0
+    for (const a of ['lite2', 'lite3', 'lite4', 'lite101', 'lite102', 'lite103']) lamps.setField(a, 0);
+    R.m.endOfBall(s.lastBall);                              // mission cancelled: state 0 (32 when the game is over)
+    G.outer_circle.groupReset();                            // rank lamps stay lit; only their animations stop
+    G.middle_circle.groupReset();
+    if (s.rankFlashPending) {                               // a promotion flash was still running: finish the progress reset now
+      G.outer_circle.broadcast('off');
+      s.rankFlashPending = false;
+      R.cancelH('rankFlash');
+    }
+    s.tilted = false;                                       // ClearTiltLock
+    physics.setTiltLock(false);
+    lamps.clearTiltLock();
+    if (lamps.lightOn('lite58')) lamps.off('lite58'); else s.bonus = POTS.bonusAfterBall;
+  }
+
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  // Tilt (SPEC 4.11, 5.2.8)
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  function tilt() {
+    R.infoBox.clear();
+    R.missionBox.clear();
+    R.info(INFO.tilt, -1);
+    R.play('TILT');
+    lamps.fuel.reset();                                     // the fuel gauge level is reset on tilt
+    lamps.tiltOff();
+    s.tilted = true;
+    physics.setTiltLock(true);
+    R.startH('tilt', TIMING.tiltTimeout, () => physics.forceDrainAll());
+  }
+
+  function onNudgeCount(e) {
+    if (s.tilted || s.phase !== 'playing') return;
+    if (e.level === 'warn') R.info(INFO.careful, TIMING.carefulText);
+    else if (e.level === 'tilt' && !s.ballInDrain) tilt();
+  }
+
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  // Game over, EndGame, high scores (SPEC 5.2.7)
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  const scoreCount = () => s.playerCount;
+  function anyQualifies() {
+    for (let i = 0; i < scoreCount(); i++) if (R.hs.qualifies(R.totalScore(i))) return true;
+    return false;
+  }
+
+  function gameOver() {
+    s.phase = 'gameOver';
+    s.gameOverEnded = false;
+    physics.setFlippersEnabled(false);
+    physics.removeAllBalls();
+    R.play('GAME_OVER');
+    R.missionBox.clear();
+    R.infoBox.clear();
+    R.info(INFO.gameOver, -1);
+    if (!s.demo && !s.cheatsUsed && anyQualifies()) {
+      R.play('SW3');
+      G.all.broadcast('flashThenOff', 3.0);
+      R.msg(T.highScore, -1);
+    }
+    R.startH('end', TIMING.gameOverToEnd, endGame);
+    if (s.demo) R.startH('demoRestart', TIMING.demoRestart, () => startNewGame());
+  }
+
+  function endGame() {
+    s.gameOverEnded = true;
+    R.infoBox.clear();
+    R.info(INFO.f2StartsNewGame, -1);
+    G.all.gameOver(1.4);
+    if (!s.demo && !s.cheatsUsed) {
+      const order = Array.from({ length: s.playerCount }, (_, i) => i).sort((a, b) => R.totalScore(b) - R.totalScore(a) || a - b);
+      for (const i of order) s.promptQueue.push({ player: i + 1, score: R.totalScore(i) });
+      if (!s.prompt) openNextPrompt();
+    }
+    cycle(0);
+  }
+
+  /** The mission box game-over cycle: title 10 s, every real player's score 3 s, every table entry 3 s, then again (plain order 1..5). */
+  function cycle(i) {
+    const list = [{ text: T.title, secs: 10 }];
+    for (let p = 0; p < s.playerCount; p++) list.push({ text: fmt(T.playerScore, p + 1, R.totalScore(p)), secs: 3 });
+    R.hs.entries().forEach((e, k) => { if (e.score > 0) list.push({ text: fmt(T.highScoreN, k + 1, e.score), secs: 3 }); });
+    const item = list[i % list.length];
+    R.msg(item.text, item.secs);
+    R.startH('cycle', item.secs, () => cycle((i + 1) % list.length));
+  }
+
+  function openNextPrompt() {
+    s.prompt = null;
+    while (s.promptQueue.length) {
+      const p = s.promptQueue.shift();
+      if (R.hs.qualifies(p.score)) {
+        s.prompt = { player: p.player, rank: R.hs.rankOf(p.score), score: p.score, defaultName: 'Player ' + p.player };
+        return;
+      }
+    }
+  }
+
+  /** Queues a name prompt for (player, score); opens it at once when none is showing (debug key H). */
+  function queuePrompt(player, score) {
+    s.promptQueue.push({ player, score });
+    if (!s.prompt) openNextPrompt();
+  }
+
+  /** @param {string|null} name null = cancel */
+  function submitName(name) {
+    const p = s.prompt;
+    if (!p) return;
+    if (name !== null && name !== undefined) {
+      const text = String(name);
+      R.hs.insert(text.trim() === '' ? p.defaultName : text, p.score);
+    }
+    openNextPrompt();
+  }
+
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  // Pause, demo, exit
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  function setPaused(on) {
+    const v = !!on;
+    if (v === s.paused) return;
+    s.paused = v;
+    if (s.phase === 'idle') return;
+    R.infoBox.clear();
+    if (v) R.info(INFO.gamePaused, -1);
+    else if (s.phase === 'gameOver') R.info(s.gameOverEnded ? INFO.f2StartsNewGame : INFO.gameOver, -1);
+    else R.info(INFO.continuePlay, 5);
+  }
+
+  /** Demo ended by the user: table reset, game-over state, mission box cleared, "F2 Starts New Game". */
+  function endDemo() {
+    resetEverything();
+    physics.setFlippersEnabled(false);
+    s.phase = 'gameOver';
+    s.gameOverEnded = true;
+    R.info(INFO.f2StartsNewGame, -1);
+    G.all.gameOver(1.4);
+  }
+
+  function setDemo(on) {
+    const v = !!on;
+    if (v === s.demo) return;
+    s.demo = v;
+    if (v) startNewGame(); else endDemo();
+  }
+
+  /** Exit: table reset, phase idle, no text. */
+  function stopGame() {
+    s.demo = false;
+    resetEverything();
+    s.phase = 'idle';
+  }
+
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  // Input gating (ARCHITECTURE 7.8)
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  const FLIPPER_SIDE = { flipperLeft: 'left', flipperRight: 'right' };
+  const NUDGE_DIR = { nudgeLeft: 'left', nudgeRight: 'right', nudgeBottom: 'bottom' };
+
+  const inputOpen = () => s.phase === 'playing' && !s.paused && !s.demo && !s.tilted;
+
+  function input(action, down) {
+    const on = !!down;
+    if (FLIPPER_SIDE[action]) {
+      if (!on || inputOpen()) physics.setFlipperButton(FLIPPER_SIDE[action], on);
+    } else if (action === 'plunger') {
+      if (!on || inputOpen()) physics.setPlungerButton(on);
+    } else if (NUDGE_DIR[action]) {
+      if (!on || inputOpen()) physics.nudge(NUDGE_DIR[action], on);
+    }
+  }
+
+  function launchBall() {
+    if (s.phase !== 'playing' || s.demo || s.paused) return false;
+    return physics.launchInstant() !== false;
+  }
+
+  function focusLost() {
+    physics.setFlipperButton('left', false);
+    physics.setFlipperButton('right', false);
+    // a player who pulled the plunger gets it back WITHOUT a half-power launch behind their back; the demo's own timed pull still releases (it has no key)
+    if (!s.demo && typeof physics.cancelPlunger === 'function') physics.cancelPlunger(); else physics.setPlungerButton(false);
+  }
+
+  R.flow = {
+    newGame, startNewGame, stopGame, setDemo, setPaused, input, launchBall, focusLost, submitName, queuePrompt, openNextPrompt,
+    feedBall, onPlungerFed, onDrain, onNudgeCount, tilt, clearTimers, endOfBallReset, gameOver, endGame,
+  };
+}
diff --git a/public/games/space-cadet/src/rules/highscores.js b/public/games/space-cadet/src/rules/highscores.js
new file mode 100644
index 0000000..eb69043
--- /dev/null
+++ b/public/games/space-cadet/src/rules/highscores.js
@@ -0,0 +1,87 @@
+/**
+ * src/rules/highscores.js
+ * OWNER: RULES
+ * STATUS: IMPLEMENTED
+ * CONTRACT: ARCHITECTURE.md 7.5; type HighScoreTableApi (src/types.js); SPEC 5.2.7, 6.6
+ * HighScoreTable: exactly 5 entries sorted by score descending; an empty slot is {name:'', score:-999}.
+ *   qualifies(score)  score > 0 and strictly better than at least one slot (= better than the 5th slot)
+ *   insert(name, score) -> rank 1..5 (0 = not inserted); entries below shift down; names are trimmed to 31 chars; onChange(entries) fires after it
+ *   load(entries)     replaces the contents (sanitised to exactly 5, sorted, names clipped), does NOT call onChange
+ *   clear()           blanks the table and calls onChange
+ *   rankOf(score)     ADDITIVE helper: the rank the score would get (1..5) or 0, without inserting (used for the name prompt)
+ * Ties: a new score equal to an existing one ranks BELOW it (the earlier holder keeps the higher place).
+ * Persistence is main.js' job (it assigns `onChange` and feeds `load`); this class never touches storage.
+ * ASSUMPTIONS: entries whose score is not a finite number are treated as empty slots on load; the empty/blank name of an inserted entry is kept as ''.
+ */
+
+const SLOTS = 5;
+const MAX_NAME = 31;
+const EMPTY_SCORE = -999;
+
+/** @returns {{name:string, score:number}} */
+function blank() { return { name: '', score: EMPTY_SCORE }; }
+
+export class HighScoreTable {
+  /** @type {((entries: {name:string, score:number}[]) => void) | null} */
+  onChange = null;
+
+  /** @param {{name:string, score:number}[]} [entries] optional initial contents */
+  constructor(entries) {
+    this._e = Array.from({ length: SLOTS }, blank);
+    if (entries) this.load(entries);
+  }
+
+  /** @returns {{name:string, score:number}[]} a fresh copy of the 5 entries */
+  entries() { return this._e.map((x) => ({ name: x.name, score: x.score })); }
+
+  /** @param {number} score @returns {boolean} */
+  qualifies(score) {
+    return Number.isFinite(score) && score > 0 && score > this._e[SLOTS - 1].score;
+  }
+
+  /** @param {number} score @returns {number} 1..5 or 0 */
+  rankOf(score) {
+    if (!this.qualifies(score)) return 0;
+    let i = 0;
+    while (i < SLOTS && this._e[i].score >= score) i++;
+    return i < SLOTS ? i + 1 : 0;
+  }
+
+  /**
+   * @param {string} name
+   * @param {number} score
+   * @returns {number} rank 1..5, or 0 when the score did not make the table
+   */
+  insert(name, score) {
+    const rank = this.rankOf(score);
+    if (rank === 0) return 0;
+    const clean = String(name === undefined || name === null ? '' : name).trim().slice(0, MAX_NAME);
+    this._e.splice(rank - 1, 0, { name: clean, score });
+    this._e.length = SLOTS;
+    if (typeof this.onChange === 'function') this.onChange(this.entries());
+    return rank;
+  }
+
+  /** @param {{name:string, score:number}[]} entries */
+  load(entries) {
+    const list = [];
+    if (Array.isArray(entries)) {
+      for (const x of entries) {
+        if (!x || typeof x !== 'object') continue;
+        const score = Number(x.score);
+        if (!Number.isFinite(score) || score <= 0) continue;
+        list.push({ name: String(x.name === undefined || x.name === null ? '' : x.name).trim().slice(0, MAX_NAME), score });
+      }
+    }
+    list.sort((a, b) => b.score - a.score);            // stable: equal scores keep their stored order
+    this._e = Array.from({ length: SLOTS }, (_, i) => list[i] || blank());
+  }
+
+  clear() {
+    this._e = Array.from({ length: SLOTS }, blank);
+    if (typeof this.onChange === 'function') this.onChange(this.entries());
+  }
+
+  /** @returns {{name:string, score:number}[]} */
+  toJSON() { return this.entries(); }
+}
diff --git a/public/games/space-cadet/src/rules/missions.js b/public/games/space-cadet/src/rules/missions.js
new file mode 100644
index 0000000..211acd1
--- /dev/null
+++ b/public/games/space-cadet/src/rules/missions.js
@@ -0,0 +1,466 @@
+/**
+ * src/rules/missions.js
+ * OWNER: RULES
+ * STATUS: IMPLEMENTED
+ * CONTRACT: ARCHITECTURE.md 7; SPEC 5.7 (all), 5.5 (fuel callbacks), 5.8 (rank points), 5.9 (Secret / Space Radiation wormhole use)
+ * The mission state machine (`field(lite198)`): state 0 WaitingDeployment, 1 SelectMission, 2..18 the 17 missions, 20..24 and 25..31 their later
+ * parts / the Maelstrom chain, 32 GameOver. Table events arrive as neutral events through forward(ev) AFTER the component's own scoring handler
+ * (features.js) has run; the controller of the CURRENT state reacts. Event kinds:
+ *   bumper{name,attack} rebounder popup{name} solo{name,bank,index} lane{name,lane} fuelRoll{n} spaceWarp ramp flag hyperspace blackHole
+ *   wormhole{id} bumperLevel{group,level} boosterSet
+ * Public: forward(ev), deploy() (0 -> 1), accept(), endOfBall(gameOver), showText() (refresh the mission box), state / counter (read-only fields).
+ * Fuel hooks (SPEC 5.5) are registered here: beforeSetLevel re-evaluates the select prompt with the OLD level (callback-order quirk), tick shows
+ * "Warning -- Low Fuel" at level 1, ended aborts a running mission.
+ * ASSUMPTIONS: hazard-bank progress of Stray Comet / Space Radiation is tracked in the mission itself (fresh hits only; the lamp registers
+ * field(lite104/107) are also maintained for display); on a mission end the wormhole destination register is cleared together with its lamps
+ * (SPEC 5.7.2 issue #124 fix); goal lamps of the stages the SPEC does not name (Maelstrom 25 / 26) reuse the hazard / lane arrows;
+ * after "Warning -- Low Fuel" the mission box restores the mission's own text.
+ */
+
+/** @param {object} R rules context (state.js) */
+export function installMissions(R) {
+  const { lamps, D, s, G } = R;
+  const { MISSIONS, MISSION_NAMES, TIMING, fmt } = D;
+  const T = D.MISSION_TEXT;
+
+  const M = {
+    state: 0,            // field(lite198)
+    selected: 0,         // mission id picked in state 1 (field(lite56) while selecting), 0 = none
+    counter: 0,          // remaining count of the running stage (field(lite56) while running)
+    stage: 0,            // sub-stage inside a state (Stray Comet / Black Hole / Space Radiation / Rescue)
+    spotBits: 0,         // field(lite101): mission spot targets hit since the last reset (1,2,4)
+    bits: 0,             // fresh hazard-bank hits since the mission started
+  };
+
+  /** state id -> MissionDef it belongs to */
+  const MISSION_OF_STATE = {};
+  for (const def of Object.values(MISSIONS)) for (const st of def.states) MISSION_OF_STATE[st] = def;
+
+  function setState(n) {
+    M.state = n;
+    lamps.setField('lite198', n);
+  }
+
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  // Mission box text
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  function textFor(st) {
+    switch (st) {
+      case 0: return T.awaitingDeployment;
+      case 2: case 20: return fmt(T.attackBumperHitsLeft, M.counter);
+      case 3: return fmt(T.launchesLeft, M.counter);
+      case 4: return fmt(T.reentriesLeft, M.counter);
+      case 5: return fmt(T.dropTargetsLeft, M.counter);
+      case 6: return M.stage === 0 ? T.fillRightHazardBanks : T.hyperspaceLaunch;
+      case 7: return M.stage === 0 ? T.upgradeLaunchBumpers : T.enterBlackHole;
+      case 8: return M.stage === 0 ? T.fillLeftHazardBanks : T.enterWormhole;
+      case 9: return fmt(T.targetsLeft, M.counter);
+      case 10: return T.upgradeAttackBumpers;
+      case 11: return M.stage === 0 ? T.upgradeFlags : T.hyperspaceLaunch;
+      case 12: return fmt(T.remoteAttackBumperHitsLeft, M.counter);
+      case 13: return fmt(T.lanePassesLeft, M.counter);
+      case 14: return fmt(T.outLanePassesLeft, M.counter);
+      case 15: return fmt(T.rollFlags, M.counter);
+      case 21: return T.hitSpaceWarpRollover;
+      case 16: return T.hitYellowWormhole;
+      case 22: return T.hitRedWormhole;
+      case 23: return T.hitGreenWormhole;
+      case 17: return fmt(T.reboundHitsLeft, M.counter);
+      case 24: return T.hitHyperspaceChuteOrLaunchRamp;
+      case 18: return fmt(T.dropTargetHitsLeft, M.counter);
+      case 25: return fmt(T.spotTargetHitsLeft, M.counter);
+      case 26: return fmt(T.lanesPassesLeft, M.counter);
+      case 27: return T.shootBallUpFuelChute;
+      case 28: return T.hitLaunchRamp;
+      case 29: return T.hitFlags;
+      case 30: return T.hitWormHole;
+      case 31: return T.hyperspaceChuteToEndMaelstrom;
+      default: return '';
+    }
+  }
+
+  /** (Re)shows the text of the current state, persistent. */
+  function showText() {
+    if (M.state === 1) { showSelectPrompt(); return; }
+    const text = textFor(M.state);
+    if (text) R.msg(text, -1);
+  }
+
+  /**
+   * State 1 prompt (SPEC 5.7.2). `fuelLevel` lets the fuel callback pass the OLD level (SPEC 5.5 ordering quirk).
+   * @param {number} [fuelLevel]
+   */
+  function showSelectPrompt(fuelLevel) {
+    const fuel = fuelLevel === undefined ? lamps.fuel.level : fuelLevel;
+    lamps.off('lite317');
+    lamps.off('lite318');
+    lamps.off('lite319');
+    if (fuel <= 0) {
+      R.msg(T.refuelShip, -1);
+      lamps.flasherStart('lite318');
+    } else if (M.selected) {
+      R.msg(fmt(T.launchRampToAccept, MISSION_NAMES[M.selected]), -1);
+      lamps.flasherStart('lite317');
+    } else {
+      R.msg(T.hitMissionTargets, -1);
+      lamps.flasherStart('lite319');
+    }
+  }
+
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  // Goal lamps
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  function clearGoals() {
+    G.goal_lights.broadcast('off');
+    lamps.off('lite55');
+    lamps.off('lite26');
+    lamps.off('lite130');
+  }
+  /** Flash the given goal lamps (numbers N -> 'liteN') indefinitely, after clearing the previous goals. */
+  function goals(...ns) {
+    for (const n of ns) lamps.flasherStart('lite' + n);
+  }
+
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  // State 1: select / accept
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  /** The select-state initialiser (SPEC 5.7.2 last paragraph); runs on 0 -> 1 and whenever a mission ends. */
+  function initSelect() {
+    M.selected = 0;
+    M.spotBits = 0;
+    M.stage = 0;
+    M.counter = 0;
+    M.bits = 0;
+    lamps.off('lite198');
+    lamps.off('lite56');
+    G.outer_circle.groupReset();
+    G.ramp_tgt_lights.broadcast('off');
+    lamps.setField('lite56', 0);
+    lamps.setField('lite101', 0);
+    R.feat.stopTrek();
+    clearGoals();
+    R.feat.clearDest();                                   // wormhole + arrow lamps off, destination cleared (issue #124 fix)
+    showSelectPrompt();
+  }
+
+  function deploy() {
+    if (M.state !== 0) return;
+    setState(1);
+    initSelect();
+  }
+
+  /** A mission spot target was hit in state 1: pick the mission for (rank, target level). */
+  function select(index) {
+    let bits = M.spotBits | (1 << index);
+    let level = index + 1;
+    if (bits === 7) { level = 4; bits = 0; }
+    M.spotBits = bits;
+    lamps.setField('lite101', bits);
+    const rank = Math.max(1, G.middle_circle.count());
+    M.selected = D.missionForRank(rank, level);
+    lamps.setField('lite56', M.selected);
+    lamps.flashThenOn('lite56', TIMING.lampFlash);
+    lamps.flasherStart('lite198');
+    R.play('SW52');                                        // sound slot of the original, file missing there -> silent
+    showSelectPrompt();
+  }
+
+  /** Launch-ramp event with a mission selected and fuel in the tank (SPEC 5.7.2 ACCEPT). */
+  function accept() {
+    const id = M.selected;
+    if (!MISSIONS[id]) return;
+    lamps.off('lite56');
+    lamps.on('lite198');
+    G.outer_circle.animationBackward(-1);
+    lamps.off('lite317');
+    lamps.off('lite318');
+    lamps.off('lite319');
+    const pts = D.acceptScoreFor(id);
+    R.specialAdd(pts);
+    R.msg(fmt(T.missionAccepted, pts), 4);                 // shown first; the mission's own text queues behind it
+    M.selected = 0;
+    enterState(id);
+  }
+
+  function selectCtl(ev) {
+    if (ev.k === 'solo' && ev.bank === 'mission') select(ev.index);
+    else if (ev.k === 'ramp' && M.selected && lamps.fuel.level > 0) accept();
+  }
+
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  // Mission initialisers
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  /** Secret mission stage lamps: rim of the wanted sink lit + its arrow flashing in the sink's colour (yellow 3, red 1, green 2). */
+  function secretStage(sink) {
+    R.feat.clearDest();
+    lamps.on(R.feat.sinkRim[sink]);
+    const [arrow, idx] = R.feat.sinkArrow[sink];
+    lamps.setOnIdx(arrow, idx);
+    lamps.flasherStart(arrow);
+  }
+
+  /** "Enter Wormhole" hint: advance the destination colour and make the arrows flash (Space Radiation stage 2, Maelstrom stage 7). */
+  function wormholeHint() {
+    R.feat.advanceDest();
+    G.bsink_arrow_lights.broadcast('flasherStart');
+  }
+
+  /** Initialises state n (the original sends "mission complete" to the NEW state as its initialiser). */
+  function enterState(n) {
+    setState(n);
+    const def = MISSION_OF_STATE[n];
+    const idx = def ? def.states.indexOf(n) : -1;
+    const c = def && idx >= 0 ? def.stageCounters[idx] : null;
+    M.counter = c === null || c === undefined ? 0 : c;
+    M.stage = 0;
+    M.bits = 0;
+    lamps.setField('lite56', M.counter);
+    clearGoals();
+    switch (n) {
+      case 2: goals(308, 311); break;
+      case 3: goals(317); break;
+      case 4: goals(307); R.feat.startTrek(); break;
+      case 5: R.feat.reenableAll(); goals(303, 309, 315); break;
+      case 6: lamps.setField('lite107', 0); goals(306); break;
+      case 7: R.feat.setBumperLevel('launch', 0, true); goals(316); break;
+      case 8: lamps.setField('lite104', 0); goals(313); break;
+      case 9:
+        R.feat.reenableAll();
+        G.lchute_tgt_lights.broadcast('off');
+        G.bpr_solotgt_lights.broadcast('off');
+        G.ramp_tgt_lights.broadcast('off');
+        G.top_circle_tgt_lights.broadcast('off');
+        goals(306, 308, 310, 313, 319);
+        break;
+      case 10: R.feat.setBumperLevel('attack', 0, true); goals(307); break;
+      case 20: goals(308, 311); break;
+      case 11: lamps.off('lite19'); lamps.off('lite20'); goals(303); break;
+      case 12: goals(308); break;
+      case 13: goals(301, 302, 307, 316, 320, 321); break;
+      case 14: goals(301, 320); break;
+      case 15: lamps.on('lite19'); lamps.on('lite20'); goals(305, 312); break;
+      case 21: goals(310); break;
+      case 16: secretStage(3); break;
+      case 22: secretStage(1); break;
+      case 23: secretStage(2); break;
+      case 17: goals(300, 322); break;
+      case 24: goals(55, 26, 304, 317); break;
+      case 18: goals(303, 309, 315); break;
+      case 25: goals(306, 313, 319); break;
+      case 26: goals(301, 302, 307, 316, 320, 321); break;
+      case 27: goals(318); break;
+      case 28: goals(317); break;
+      case 29: lamps.on('lite19'); lamps.on('lite20'); goals(305, 312); break;
+      case 30: wormholeHint(); break;
+      case 31: lamps.flasherStart('lite130'); goals(304); break;
+      default: break;
+    }
+    showText();
+  }
+
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  // Completion, abort, end of ball
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  /** Ends the running mission: state back to 1 and the select-state initialiser (SPEC 5.7.7). */
+  function finish() {
+    setState(1);
+    initSelect();
+  }
+
+  /** SPEC 5.7.7 completeMission. */
+  function complete(def) {
+    R.specialAdd(def.reward);
+    const done = T[def.doneText];
+    if (def.doneBox === 'info') R.info(done, 4); else R.msg(done, 4);
+    const promoted = R.ranks.addProgress(def.rankPts);
+    if (!promoted) {
+      R.play('SW9');
+      R.msg(fmt(T.missionCompleted, def.reward), 8);
+    }                                                      // a promotion pushed its own "Promotion to <Rank>" text and SW10
+    finish();
+  }
+
+  function timeWarpForward() {
+    const def = MISSIONS[17];
+    R.msg(T.timeWarpForward, 4);
+    const first = R.ranks.promoteOne();
+    const second = R.ranks.addProgress(def.rankPts);
+    if (!first && !second) R.play('SW9');
+    R.specialAdd(def.reward);
+    finish();
+  }
+
+  function timeWarpBackward() {
+    const def = MISSIONS[17];
+    R.msg(T.timeWarpBackward, 4);
+    R.ranks.demote();                                      // no rank progress on the backward branch
+    R.specialAdd(def.reward);
+    finish();
+  }
+
+  /** Fuel ran out during a mission (SPEC 5.5). */
+  function abort() {
+    R.feat.stopTrek();
+    R.msg(T.missionAborted, 4);
+    finish();
+  }
+
+  /** End of ball: the old mission is cancelled; state 0 (or 32 when the game is over). */
+  function endOfBall(gameOver) {
+    M.selected = 0;
+    M.spotBits = 0;
+    M.stage = 0;
+    M.counter = 0;
+    M.bits = 0;
+    setState(gameOver ? 32 : 0);
+    lamps.setField('lite56', 0);
+    lamps.setField('lite101', 0);
+    clearGoals();                                          // the 23 goal lamps are cleared by the last "mission complete" initialiser
+  }
+
+  /** New game: forget everything. */
+  function reset() {
+    endOfBall(false);
+  }
+
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  // Counting helpers and the controllers of the running missions
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  function counterDone() {
+    switch (M.state) {
+      case 15: enterState(21); break;
+      case 17: enterState(24); break;
+      case 18: enterState(25); break;
+      case 25: enterState(26); break;
+      case 26: enterState(27); break;
+      default: complete(MISSION_OF_STATE[M.state]);
+    }
+  }
+
+  function countDown() {
+    M.counter -= 1;
+    lamps.setField('lite56', M.counter);
+    if (M.counter <= 0) counterDone(); else showText();
+  }
+
+  function hazardCtl(ev, bank, nextStage) {
+    if (M.stage !== 0 || ev.k !== 'solo' || ev.bank !== bank) return;
+    M.bits |= 1 << ev.index;
+    if ((M.bits & 7) === 7) nextStage();
+  }
+
+  function forward(ev) {
+    if (ev.k === 'solo' && ev.bank === 'mission' && M.state !== 1) R.play('SW49D');
+    switch (M.state) {
+      case 1: selectCtl(ev); break;
+      case 2: case 20:
+        if (ev.k === 'bumper' && ev.attack) countDown();
+        break;
+      case 3:
+        if (ev.k === 'ramp') countDown();
+        break;
+      case 4:
+        if (ev.k === 'lane' && ev.lane === 'reentry') countDown();
+        break;
+      case 5: case 18:
+        if (ev.k === 'popup') countDown();
+        break;
+      case 6:                                              // Stray Comet
+        hazardCtl(ev, 'rightHazard', () => { M.stage = 1; clearGoals(); goals(304); showText(); });
+        if (ev.k === 'hyperspace' && M.stage === 1) complete(MISSIONS[6]);
+        break;
+      case 7:                                              // Black Hole
+        if (ev.k === 'bumperLevel' && ev.group === 'launch') {
+          const st = ev.level > 0 ? 1 : 0;
+          if (st !== M.stage) { M.stage = st; clearGoals(); goals(st ? 314 : 316); showText(); }
+        } else if (ev.k === 'blackHole' && s.launchLevel > 0) {
+          complete(MISSIONS[7]);
+        }
+        break;
+      case 8:                                              // Space Radiation
+        hazardCtl(ev, 'leftHazard', () => { M.stage = 1; clearGoals(); wormholeHint(); showText(); });
+        if (ev.k === 'wormhole' && M.stage === 1) complete(MISSIONS[8]);
+        break;
+      case 9:
+        if (ev.k === 'popup' || ev.k === 'solo') countDown();
+        break;
+      case 10:                                             // Alien Menace part 1
+        if (ev.k === 'bumperLevel' && ev.group === 'attack' && ev.level > 0) enterState(20);
+        break;
+      case 11:                                             // Rescue
+        if (ev.k === 'boosterSet' && M.stage === 0 && lamps.lightOn('lite20')) {
+          M.stage = 1; clearGoals(); goals(304); showText();
+        } else if (ev.k === 'hyperspace' && M.stage === 1 && lamps.lightOn('lite20')) {
+          complete(MISSIONS[11]);
+        }
+        break;
+      case 12:
+        if (ev.k === 'bumper' && ev.name === 'a_bump4') countDown();
+        break;
+      case 13: case 26:
+        if (ev.k === 'lane') countDown();
+        break;
+      case 14:
+        if (ev.k === 'lane' && ev.lane === 'outlane') countDown();
+        break;
+      case 15: case 29:                                    // Cosmic Plague part 1 counts flag frames; Maelstrom stage 6 needs one
+        if (ev.k === 'flag') { if (M.state === 29) enterState(30); else countDown(); }
+        break;
+      case 21:
+        if (ev.k === 'spaceWarp') complete(MISSIONS[15]);
+        break;
+      case 16:                                             // Secret: yellow, red, green
+        if (ev.k === 'wormhole' && ev.id === 3) enterState(22);
+        break;
+      case 22:
+        if (ev.k === 'wormhole' && ev.id === 1) enterState(23);
+        break;
+      case 23:
+        if (ev.k === 'wormhole' && ev.id === 2) complete(MISSIONS[16]);
+        break;
+      case 17:
+        if (ev.k === 'rebounder') countDown();
+        break;
+      case 24:                                             // Time Warp part 2
+        if (ev.k === 'ramp') timeWarpForward();
+        else if (ev.k === 'hyperspace') timeWarpBackward();
+        break;
+      case 25:
+        if (ev.k === 'solo') countDown();
+        break;
+      case 27:
+        if (ev.k === 'fuelRoll' && ev.n === 6) enterState(28);
+        break;
+      case 28:
+        if (ev.k === 'ramp') enterState(29);
+        break;
+      case 30:
+        if (ev.k === 'wormhole') enterState(31);
+        break;
+      case 31:
+        if (ev.k === 'hyperspace') complete(MISSIONS[18]);
+        break;
+      default: break;                                      // 0 (waiting) and 32 (game over): nothing
+    }
+  }
+
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  // Fuel callbacks (SPEC 5.5)
+  // ---------------------------------------------------------------------------------------------------------------------------------
+  lamps.fuel.setHooks({
+    beforeSetLevel: () => { if (M.state === 1) showSelectPrompt(lamps.fuel.level); },      // OLD level on purpose (callback-order quirk)
+    tick: (level) => {
+      if (level === 1 && M.state !== 0 && M.state !== 32) {
+        R.msg(T.warningLowFuel, 4);
+        showText();                                        // restore the persistent text behind the warning
+      }
+    },
+    ended: () => {
+      if (M.state > 1 && M.state < 32) abort();
+      else if (M.state === 1) showSelectPrompt(0);
+    },
+  });
+
+  Object.assign(M, { forward, deploy, accept, endOfBall, reset, showText, showSelectPrompt, initSelect, enterState, abort, textFor });
+  R.m = M;
+}
diff --git a/public/games/space-cadet/src/rules/ranks.js b/public/games/space-cadet/src/rules/ranks.js
new file mode 100644
index 0000000..fc2c0a9
--- /dev/null
+++ b/public/games/space-cadet/src/rules/ranks.js
@@ -0,0 +1,76 @@
+/**
+ * src/rules/ranks.js
+ * OWNER: RULES
+ * STATUS: IMPLEMENTED
+ * CONTRACT: ARCHITECTURE.md 7.2; SPEC 5.8, 5.13.4 (rank idioms)
+ * Ranks: nine ranks = number of lit lamps of `middle_circle` (lite154..162); progress = the 18 lamps of `outer_circle`.
+ *   addProgress(n)  lit(lite16); n x outer_circle.nextOn(2 s); when the ring is full (count == 18): the ring flashes 5 s then clears,
+ *                   middle_circle.groupReset(), and (rank < 9) middle_circle.nextOn(5 s) + "Promotion to <Rank>" 8 s + sound SW10;
+ *                   otherwise from 13 lit lamps on the rank lamps rotate (animationForward(-1)) until the next group reset.
+ *   promoteOne()    cheat 'rmax' / Time Warp forward: rank + 1 at once (5 s flash), text + sound, no progress points.
+ *   demote()        Time Warp backward: highest rank lamp off, "Demotion to <Rank>" 8 s.
+ * Rank and progress persist across balls (per player, via lamps.playerChanged); they reset at New Game (lamps.resetAll).
+ * ASSUMPTIONS: at Fleet Admiral a full ring only flashes/clears (no text, no sound, no "promotion" result), as SPEC 9 #8 says.
+ */
+
+/** @param {object} R rules context (state.js) */
+export function installRanks(R) {
+  const { lamps, G, D, s } = R;
+  const T = D.MISSION_TEXT;
+  const RING = 18;
+  const HINT_AT = 13;                 // 3/4 of 18
+
+  /** Current rank 1..9 (0 before the first ball feed lit the first rank lamp). */
+  const rank = () => G.middle_circle.count();
+  const rankName = (r) => D.RANK_NAMES[Math.min(D.RANK_NAMES.length, Math.max(1, r)) - 1];
+
+  /** Promotion by +1 rank right now. Returns true when a rank lamp was added. */
+  function promoteOne() {
+    const r = rank();
+    if (r >= D.RANK_NAMES.length) return false;
+    G.middle_circle.groupReset();
+    G.middle_circle.nextOn(D.TIMING.rankFlash);
+    R.msg(D.fmt(T.promotionTo, rankName(r + 1)), 8);
+    R.play('SW10');
+    return true;
+  }
+
+  /** Demotion by one rank (Time Warp backward). Returns true when a rank lamp was removed. */
+  function demote() {
+    const r = rank();
+    if (r <= 1) return false;
+    G.middle_circle.dropTop();
+    R.msg(D.fmt(T.demotionTo, rankName(r - 1)), 8);
+    return true;
+  }
+
+  /**
+   * SPEC 5.8 AddRankProgress(n).
+   * @param {number} n progress lamps to light (18 = one full promotion)
+   * @returns {boolean} true when the rank went up
+   */
+  function addProgress(n) {
+    lamps.on('lite16');
+    G.outer_circle.groupReset();                          // stop the mission chase so the new lamps flash cleanly
+    for (let i = 0; i < n; i++) G.outer_circle.nextOn(D.TIMING.lampFlash);
+    const count = G.outer_circle.count();
+    if (count >= RING) {
+      G.outer_circle.broadcast('flashThenOff', D.TIMING.rankFlash);
+      s.rankFlashPending = true;
+      R.startH('rankFlash', D.TIMING.rankFlash, () => { s.rankFlashPending = false; });
+      G.middle_circle.groupReset();
+      const r = rank();
+      if (r < D.RANK_NAMES.length) {
+        G.middle_circle.nextOn(D.TIMING.rankFlash);
+        R.msg(D.fmt(T.promotionTo, rankName(r + 1)), 8);
+        R.play('SW10');
+        return true;
+      }
+      return false;
+    }
+    if (count >= HINT_AT) G.middle_circle.animationForward(-1);
+    return false;
+  }
+
+  R.ranks = { rank, rankName, addProgress, promoteOne, demote };
+}
diff --git a/public/games/space-cadet/src/rules/scheduler.js b/public/games/space-cadet/src/rules/scheduler.js
new file mode 100644
index 0000000..f8dab00
--- /dev/null
+++ b/public/games/space-cadet/src/rules/scheduler.js
@@ -0,0 +1,78 @@
+/**
+ * src/rules/scheduler.js
+ * OWNER: RULES
+ * STATUS: IMPLEMENTED
+ * CONTRACT: ARCHITECTURE.md 7.1
+ * Scheduler (float seconds): after(seconds, fn) -> handle, cancel(handle), cancelAll(), advance(dt), now().
+ * Fires due callbacks in (due time, insertion) order. Re-entrant: callbacks may schedule or cancel timers, and a timer that is already due
+ * when it is scheduled (delay <= 0, or short enough to land inside the span being advanced) fires within the SAME advance() call.
+ * While a callback runs, now() reports that timer's own due time, so chained `after()` calls are exact (no drift from the step size).
+ * A callback that throws is NOT swallowed (the timer is already removed, the clock stays consistent for the caller that catches).
+ * No setTimeout / Date: time enters only through advance(dt). The game "pauses" simply by not calling advance().
+ * ASSUMPTIONS: a non-finite or negative delay is treated as 0; due comparisons use a 1e-9 s tolerance so 120 Hz float accumulation never
+ * delays a timer by a whole step.
+ */
+
+const EPS = 1e-9;
+
+export class Scheduler {
+  constructor() {
+    this._now = 0;
+    this._seq = 0;
+    /** @type {{id:number, due:number, fn:() => void}[]} sorted by (due, id) */
+    this._timers = [];
+  }
+
+  /**
+   * @param {number} seconds delay from now()
+   * @param {() => void} fn
+   * @returns {number} handle (positive integer, never reused)
+   */
+  after(seconds, fn) {
+    if (typeof fn !== 'function') throw new TypeError('Scheduler.after: fn must be a function');
+    const delay = Number.isFinite(seconds) && seconds > 0 ? seconds : 0;
+    const t = { id: ++this._seq, due: this._now + delay, fn };
+    const a = this._timers;
+    let i = a.length;
+    while (i > 0 && a[i - 1].due > t.due) i--;     // after every timer with due <= t.due (insertion order among equals)
+    a.splice(i, 0, t);
+    return t.id;
+  }
+
+  /** @param {number|null|undefined} handle  unknown / already fired handles are ignored */
+  cancel(handle) {
+    if (handle === null || handle === undefined) return;
+    const a = this._timers;
+    for (let i = 0; i < a.length; i++) {
+      if (a[i].id === handle) { a.splice(i, 1); return; }
+    }
+  }
+
+  cancelAll() { this._timers.length = 0; }
+
+  /** @param {number} dt seconds to move the clock forward */
+  advance(dt) {
+    if (!(dt > 0)) return;
+    const target = this._now + dt;
+    for (;;) {
+      const t = this._timers[0];
+      if (!t || t.due > target + EPS) break;
+      this._timers.shift();
+      if (t.due > this._now) this._now = t.due;
+      t.fn();
+    }
+    if (target > this._now) this._now = target;
+  }
+
+  /** @returns {number} seconds advanced so far */
+  now() { return this._now; }
+
+  /** @returns {number} number of pending timers (diagnostics / tests) */
+  pending() { return this._timers.length; }
+
+  /** @param {number} handle @returns {boolean} true while the timer is still pending */
+  isPending(handle) {
+    for (const t of this._timers) if (t.id === handle) return true;
+    return false;
+  }
+}
diff --git a/public/games/space-cadet/src/rules/state.js b/public/games/space-cadet/src/rules/state.js
