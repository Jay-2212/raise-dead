+}
+
+/** Polygon scaled about its vertex centroid. */
+export function scalePoly(pts, f) {
+  const c = centroid(pts);
+  return pts.map((p) => [c[0] + (p[0] - c[0]) * f, c[1] + (p[1] - c[1]) * f]);
