+}
+
+// ---- floor -----------------------------------------------------------------------------------------------------------------------------
+function paintCarpet(createCanvas, rand, size) {
+  const { canvas, ctx, w, h } = make(createCanvas, size);
+  const k = w / 512;
+  ctx.fillStyle = '#07060d';
+  ctx.fillRect(0, 0, w, h);
