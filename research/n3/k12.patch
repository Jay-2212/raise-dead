+
+  function sinkCapture(e) {
+    const id = e.id;
+    if (id === 7) { physics.sinkSetRoute(7, 7, D.SINKS.find((x) => x.id === 7).holdSeconds); return; }
+    if (id !== 1 && id !== 2 && id !== 3) return;
+    const hold = D.SINKS.find((x) => x.id === id).holdSeconds;
+    const d = destOf();
