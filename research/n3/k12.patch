+    for (const u of [0.26, 0.43, 0.6]) {
+      polyFill(ctx, [[(u + 0.05) * L, 0], [(u - 0.04) * L, 0.16], [(u - 0.04) * L, -0.16]], '#0a1570', rgba('#000000', 0.5), 0.02);
+    }
+    wavyClosed(ctx, body, 0.035, rand);
+    ctx.strokeStyle = rgba('#9fd8ff', 0.5);
