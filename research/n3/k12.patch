+
+    mesh.rotation.setFromQuaternion(arrow.quaternion);
+    mesh.position.addVectors(fromPoint, deltaVector.multiplyScalar(0.5));
+    mesh.updateMatrix();
+
+    self.object3d.add(mesh);
+  };
