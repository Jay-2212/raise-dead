index 0000000..e9d3ea4
--- /dev/null
+++ b/public/games/space-cadet/src/audio/cache.js
@@ -0,0 +1,108 @@
+/**
+ * src/audio/cache.js
+ * OWNER: AUDIO
+ * STATUS: IMPLEMENTED
+ * CONTRACT: ARCHITECTURE.md 10.2 step 4 (optional); SPEC 7.5 step 1
+ * createCache(opts) -> {get(key), getEntry(key), put(key, buf, source?), clear(), isAvailable()}
+ * Optional IndexedDB cache of VALIDATED sound bytes in the visitor's own browser, keyed `NAME.WAV|sha1`.
+ * Every IndexedDB access is wrapped in try/catch; a missing / blocked / failing IndexedDB (private windows, cleared site data,
+ * Node) turns the cache into a silent no-op. Nothing is touched at import time or at creation time (the database is opened
+ * lazily on first use).
+ *
+ * ASSUMPTIONS:
+ *  - Callers re-validate bytes (size + SHA-1) after a cache read, so a corrupted entry can never be played.
+ *  - Entries are {buf, source}; get() returns just the ArrayBuffer (contract), getEntry() also returns where the bytes came from.
+ *  - After the first open failure the cache is permanently disabled for this instance (no retry storms).
+ */
+
+/**
+ * @param {{indexedDB?:any, dbName?:string, storeName?:string, version?:number}} [opts]
+ *   indexedDB: injected IDBFactory (default globalThis.indexedDB, resolved lazily)
+ */
+export function createCache(opts = {}) {
+  const dbName = opts.dbName || 'space-cadet-pinball-sounds';
+  const storeName = opts.storeName || 'files';
+  const version = opts.version || 1;
+  /** @type {Promise<any>|null} */
+  let dbPromise = null;
+  let disabled = false;
+
+  function open() {
+    if (disabled) return Promise.resolve(null);
+    if (dbPromise) return dbPromise;
+    dbPromise = new Promise((resolve) => {
+      try {
+        const factory = opts.indexedDB !== undefined ? opts.indexedDB : globalThis.indexedDB;
+        if (!factory || typeof factory.open !== 'function') { disabled = true; resolve(null); return; }
+        const req = factory.open(dbName, version);
+        req.onupgradeneeded = () => {
+          try {
+            const db = req.result;
+            if (!db.objectStoreNames.contains(storeName)) db.createObjectStore(storeName);
+          } catch { /* handled by onerror / later failures */ }
+        };
+        req.onsuccess = () => resolve(req.result || null);
+        req.onerror = () => { disabled = true; resolve(null); };
+        req.onblocked = () => { disabled = true; resolve(null); };
+      } catch {
+        disabled = true;
+        resolve(null);
+      }
+    });
+    return dbPromise;
+  }
+
+  /** Run one request against the store; resolves with its result or `fallback` on any failure. */
+  async function run(mode, fn, fallback) {
+    try {
+      const db = await open();
+      if (!db) return fallback;
+      return await new Promise((resolve) => {
+        try {
+          const tx = db.transaction(storeName, mode);
+          const req = fn(tx.objectStore(storeName));
+          let result = fallback;
+          if (req) {
+            req.onsuccess = () => { result = req.result === undefined ? fallback : req.result; };
+            req.onerror = () => resolve(fallback);
+          }
+          tx.oncomplete = () => resolve(result);
+          tx.onerror = () => resolve(fallback);
+          tx.onabort = () => resolve(fallback);
+        } catch {
+          resolve(fallback);
+        }
+      });
+    } catch {
+      return fallback;
+    }
+  }
+
+  const api = {
+    /** @param {string} key @returns {Promise<{buf:ArrayBuffer, source:string|null}|null>} */
+    async getEntry(key) {
+      const v = await run('readonly', (s) => s.get(String(key)), null);
+      if (v instanceof ArrayBuffer) return { buf: v, source: null };
+      if (v && v.buf instanceof ArrayBuffer) return { buf: v.buf, source: typeof v.source === 'string' ? v.source : null };
+      return null;
+    },
+    /** @param {string} key @returns {Promise<ArrayBuffer|null>} */
+    async get(key) {
+      const e = await api.getEntry(key);
+      return e ? e.buf : null;
+    },
+    /** @param {string} key @param {ArrayBuffer} buf @param {string} [source] @returns {Promise<boolean>} true when stored */
+    async put(key, buf, source) {
+      if (!(buf instanceof ArrayBuffer)) return false;
+      const ok = await run('readwrite', (s) => s.put({ buf, source: source || null }, String(key)), false);
+      return ok !== false;
+    },
+    /** Remove every cached sound. @returns {Promise<void>} */
+    async clear() {
+      await run('readwrite', (s) => s.clear(), null);
+    },
+    /** True unless IndexedDB was found missing / failing. */
+    isAvailable() { return !disabled; },
+  };
+  return api;
+}
diff --git a/public/games/space-cadet/src/audio/loader.js b/public/games/space-cadet/src/audio/loader.js
new file mode 100644
index 0000000..36f8e79
--- /dev/null
+++ b/public/games/space-cadet/src/audio/loader.js
@@ -0,0 +1,235 @@
+/**
+ * src/audio/loader.js
+ * OWNER: AUDIO
+ * STATUS: IMPLEMENTED
+ * CONTRACT: ARCHITECTURE.md 10.2; SPEC 7.5; sound policy 0.2 #4
+ * loadSounds({fetchImpl, sha1Fn, data, onProgress, concurrency, music, cache, sleep, skip, musicOnly, onFile, localMissLimit, discoverLocal})
+ *   -> Promise<{files: Map<fileKey, ArrayBuffer>, music: ArrayBuffer|null, sources: Record<fileKey, 'local'|'S1'|'S5'>}>
+ * The network layer, pure (no AudioContext, no DOM). Per file, in this order:
+ *   0. optional IndexedDB cache (re-validated);
+ *   1. candidateUrls(): same-origin ./sounds/<NAME> (upper then lower spelling), Internet Archive S1, Internet Archive S5.
+ *      - 404 or any other 4xx  => this source is skipped at once (no retry);
+ *      - network error / 5xx / 429 / 408 => up to 2 retries with 0.5 s then 1.5 s backoff on the SAME source, then the next source;
+ *      - bytes are accepted ONLY if byteLength and SHA-1 equal the manifest; anything else is discarded and the next source is tried.
+ * Never rejects: if every source fails for a file the file is simply absent from `files` (the game stays silent for it).
+ * Concurrency is at most `concurrency` (default 4) requests in flight. The six absent files and PINBALL2.MID are never requested.
+ *
+ * ASSUMPTIONS:
+ *  - Browsers print every 404 fetch in the console, and an empty ./sounds/ folder (the normal case) would cost two per file. Two
+ *    guards keep the console clean without changing which files are used (both only skip requests that would 404):
+ *    (a) `discoverLocal: true` (the facade sets it): one GET of ./sounds/ - if the server answers with a directory listing that
+ *        contains our own README.txt, only the sound files named in the listing are requested locally (exact spelling from the
+ *        listing; zero 404s). Any other answer (404, 403, a page without README.txt, an error) = "unknown" and the probing below is used.
+ *    (b) circuit breaker for blind probing: after `localMissLimit` (default 4) files whose every local spelling failed while NO
+ *        local file has ever been found, the local source is skipped for the remaining files (a few requests are already in
+ *        flight, so about 8-12 probes happen). A folder holding any of the first files probed is never affected.
+ *        Pass Infinity for the literal "probe every file" policy.
+ *  - After a local hit on the lower-case spelling only, the lower-case spelling is tried first from then on.
+ *  - Music (the MID) is loaded as an extra job after the sounds only when `music` is true, from local or S1 only (S5 excluded by
+ *    candidateUrls), and does not count towards progress.total.
+ *  - A cache hit is reported with the source stored with it (default 'local' if unknown).
+ */
+import { candidateUrls, resolveSoundData } from './sources.js';
+import { validateBytes, sha1Hex } from './validate.js';
+
+/** Backoff before retry n (0.5 s then 1.5 s): 1 initial attempt + 2 retries per source. */
+export const RETRY_DELAYS_MS = Object.freeze([500, 1500]);
+
+const defaultSleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+
+const LOCAL_DIR = './sounds/';
+
+/**
+ * Ask the server for a listing of ./sounds/ (python http.server, nginx / Apache autoindex ...). Trusted only if the listing links
+ * our own README.txt, which proves it is a listing of THIS folder.
+ * @param {typeof fetch} fetchImpl
+ * @param {{dir?:string, isSoundName?:(name:string)=>boolean}} [o]
+ * @returns {Promise<Map<string,string>|null>} UPPER-CASE file name -> name as spelled on the server; null = unknown
+ */
+export async function discoverLocalIndex(fetchImpl, o = {}) {
+  try {
+    const res = await fetchImpl(o.dir || LOCAL_DIR, { cache: 'no-cache' });
+    if (!res) return null;
+    const ok = res.ok !== undefined ? !!res.ok : (res.status >= 200 && res.status < 300);
+    if (!ok) return null;
+    const text = new TextDecoder('utf-8').decode(await res.arrayBuffer());
+    if (text.length > 2_000_000) return null;
+    const all = new Map();
+    for (const m of text.matchAll(/href\s*=\s*["']([^"'#?]+)["']/gi)) {
+      let href = m[1];
+      try { href = decodeURIComponent(href); } catch { /* keep raw */ }
+      const name = href.slice(href.lastIndexOf('/') + 1);
+      if (name && !all.has(name.toUpperCase())) all.set(name.toUpperCase(), name);
+    }
+    if (!all.has('README.TXT')) return null; // not provably a listing of this folder
+    const sound = o.isSoundName || ((n) => /^(sound\d+d?\.wav|pinball\.mid)$/i.test(n));
+    const index = new Map();
+    for (const [upper, name] of all) if (sound(name)) index.set(upper, name);
+    return index;
+  } catch {
+    return null;
+  }
+}
+
+/** Swallow errors from optional collaborators (cache, callbacks). */
+async function safely(fn, fallback) {
+  try { return await fn(); } catch { return fallback; }
+}
+
+/**
+ * @param {{
+ *   fetchImpl?: typeof fetch, sha1Fn?: (b:ArrayBuffer)=>Promise<string>, data?: any,
+ *   onProgress?: (p:{done:number, loaded:number, total:number, key:string, ok:boolean, source:string|null, music:boolean})=>void,
+ *   onFile?: (key:string, buf:ArrayBuffer, source:string, isMusic:boolean)=>void,
+ *   concurrency?: number, music?: boolean, musicOnly?: boolean, skip?: Iterable<string>,
+ *   cache?: {get:Function, getEntry?:Function, put:Function}|null, sleep?: (ms:number)=>Promise<void>, localMissLimit?: number,
+ *   discoverLocal?: boolean,
+ * }} [opts]
+ * @returns {Promise<{files: Map<string, ArrayBuffer>, music: ArrayBuffer|null, sources: Record<string, string>}>}
+ */
+export async function loadSounds(opts = {}) {
+  /** @type {{files: Map<string, ArrayBuffer>, music: ArrayBuffer|null, sources: Record<string, string>}} */
+  const result = { files: new Map(), music: null, sources: {} };
+  try {
+    await run(opts || {}, result);
+  } catch {
+    /* never reject: whatever was loaded so far is returned */
+  }
+  return result;
+}
+
+async function run(opts, result) {
+  const D = resolveSoundData(opts.data);
+  const fetchImpl = typeof opts.fetchImpl === 'function'
+    ? opts.fetchImpl
+    : (typeof globalThis.fetch === 'function' ? globalThis.fetch.bind(globalThis) : null);
+  const sha1Fn = typeof opts.sha1Fn === 'function' ? opts.sha1Fn : sha1Hex;
+  const sleep = typeof opts.sleep === 'function' ? opts.sleep : defaultSleep;
+  const cache = opts.cache || null;
+  const onProgress = typeof opts.onProgress === 'function' ? opts.onProgress : null;
+  const onFile = typeof opts.onFile === 'function' ? opts.onFile : null;
+  const concurrency = Math.max(1, Math.min(8, Math.trunc(Number(opts.concurrency) || 4)));
+  const missLimit = opts.localMissLimit === undefined ? 4 : Number(opts.localMissLimit);
+  const skip = new Set(opts.skip || []);
+
+  const jobs = [];
+  if (!opts.musicOnly) {
+    for (const key of Object.keys(D.SOUND_FILES)) if (!skip.has(key)) jobs.push({ key, music: false });
+  }
+  const total = jobs.length;
+  if ((opts.music || opts.musicOnly) && !skip.has('PINBALL')) jobs.push({ key: 'PINBALL', music: true });
+
+  const state = { localHits: 0, localMisses: 0, localOff: false, lowerFirst: false, done: 0, loaded: 0 };
+  /** The ./sounds/ listing is requested lazily (a fully cached session makes no request at all) and only once. */
+  let indexPromise = null;
+  const ensureLocalIndex = () => {
+    if (!opts.discoverLocal || !fetchImpl) return Promise.resolve(null);
+    if (!indexPromise) indexPromise = discoverLocalIndex(fetchImpl);
+    return indexPromise;
+  };
+
+  /** One fetch attempt sequence (initial try + retries) for one candidate. Resolves with validated bytes or null. */
+  async function fetchCandidate(cand, expected) {
+    if (!fetchImpl) return null;
+    const isLocal = cand.source === 'local';
+    const init = isLocal ? { cache: 'no-cache' } : { mode: 'cors', credentials: 'omit', cache: 'force-cache' };
+    for (let attempt = 0; attempt <= RETRY_DELAYS_MS.length; attempt++) {
+      if (attempt > 0) await safely(() => sleep(RETRY_DELAYS_MS[attempt - 1]));
+      let res;
+      try {
+        res = await fetchImpl(cand.url, init);
+      } catch {
+        continue; // network error: retry the same source
+      }
+      if (!res) continue;
+      const ok = res.ok !== undefined ? !!res.ok : (res.status >= 200 && res.status < 300);
+      if (!ok) {
+        const st = Number(res.status) || 0;
+        if (st >= 500 || st === 429 || st === 408) continue; // transient: retry the same source
+        return null; // 404 and other 4xx: skip this source immediately
+      }
+      let buf;
+      try {
+        buf = await res.arrayBuffer();
+      } catch {
+        continue; // body failed mid-transfer: treat like a network error
+      }
+      return (await validateBytes(expected, buf, sha1Fn)) ? buf : null; // wrong bytes: discard, next source
+    }
+    return null;
+  }
+
+  async function runJob(job) {
+    const expected = job.music ? D.MUSIC_FILE : D.SOUND_FILES[job.key];
+    const fileName = job.music ? D.MUSIC_FILE.name : D.fileNameOf(job.key);
+    const cacheKey = fileName + '|' + expected.sha1;
+    let buf = null;
+    let source = null;
+
+    if (cache) {
+      const entry = await safely(
+        async () => (typeof cache.getEntry === 'function' ? cache.getEntry(cacheKey) : { buf: await cache.get(cacheKey), source: null }),
+        null,
+      );
+      if (entry && entry.buf && (await validateBytes(expected, entry.buf, sha1Fn))) { buf = entry.buf; source = entry.source || 'local'; }
+    }
+
+    if (!buf) {
+      let cands = candidateUrls(job.key, { music: job.music, data: D });
+      const localIndex = await ensureLocalIndex();
+      if (localIndex) { // the server listed ./sounds/: request only what is really there, with the server's own spelling
+        const actual = localIndex.get(fileName.toUpperCase());
+        cands = cands.filter((c) => c.source !== 'local');
+        if (actual) cands.unshift({ source: 'local', url: LOCAL_DIR + encodeURIComponent(actual) });
+      } else if (state.lowerFirst) { // a lower-case-only folder: try that spelling first
+        cands = [...cands.filter((c) => c.source === 'local').reverse(), ...cands.filter((c) => c.source !== 'local')];
+      }
+      let triedLocal = false;
+      let hitLocal = false;
+      for (const cand of cands) {
+        const isLocal = cand.source === 'local';
+        if (isLocal && state.localOff) continue;
+        if (isLocal) triedLocal = true;
+        const got = await fetchCandidate(cand, expected);
+        if (!got) continue;
+        buf = got;
+        source = cand.source;
+        if (isLocal) {
+          hitLocal = true;
+          state.localHits++;
+          const base = cand.url.slice(cand.url.lastIndexOf('/') + 1);
+          if (base !== base.toUpperCase() && base === base.toLowerCase()) state.lowerFirst = true;
+        }
+        break;
+      }
+      if (triedLocal && !hitLocal) {
+        state.localMisses++;
+        if (state.localHits === 0 && state.localMisses >= missLimit) state.localOff = true;
+      }
+      if (buf && cache) await safely(() => cache.put(cacheKey, buf, source));
+    }
+
+    if (buf) {
+      if (job.music) result.music = buf;
+      else result.files.set(job.key, buf);
+      result.sources[job.key] = source;
+      if (!job.music) state.loaded++;
+      if (onFile) await safely(() => onFile(job.key, buf, source, job.music));
+    }
+    if (!job.music) state.done++;
+    if (onProgress) {
+      const info = { done: state.done, loaded: state.loaded, total, key: job.key, ok: !!buf, source: buf ? source : null, music: job.music };
+      await safely(() => onProgress(info));
+    }
+  }
+
+  let next = 0;
+  const worker = async () => {
+    for (;;) {
+      const i = next++;
+      if (i >= jobs.length) return;
+      try { await runJob(jobs[i]); } catch { /* one bad file never stops the others */ }
+    }
+  };
+  await Promise.all(Array.from({ length: Math.min(concurrency, jobs.length) }, worker));
+}
diff --git a/public/games/space-cadet/src/audio/midi.js b/public/games/space-cadet/src/audio/midi.js
new file mode 100644
index 0000000..1a5dd2f
--- /dev/null
+++ b/public/games/space-cadet/src/audio/midi.js
@@ -0,0 +1,199 @@
+/**
+ * src/audio/midi.js
+ * OWNER: AUDIO
+ * STATUS: IMPLEMENTED
+ * CONTRACT: ARCHITECTURE.md 10.4
+ * parseMidi(buf) -> {format, ticksPerBeat, trackCount, events: [{t, ch, type, a, b}], tempoMap, duration}
+ * Standard MIDI File reader (type 0 and 1; type 2 tracks are merged like type 1), pure, never throws (garbage in -> empty result).
+ *   - tempo map honoured (set-tempo meta events from any track, last one at a tick wins; default 120 bpm);
+ *   - running status, any delta-time length up to 4 bytes, sysex / meta / unknown chunks skipped (only set-tempo and end-of-track used);
+ *   - 'RIFF .... RMID' wrapped files are accepted (the 'MThd' header is searched in the first 64 bytes);
+ *   - SMPTE time division is supported (fixed seconds per tick, tempo ignored).
+ * Event `type` strings: noteOn (a=note, b=velocity), noteOff (a=note, b=velocity; a noteOn with velocity 0 is reported as noteOff),
+ * polyPressure (a=note, b=pressure), controlChange (a=controller, b=value), programChange (a=program, b=0), channelPressure (a=value, b=0),
+ * pitchBend (a=-8192..8191, b=0). `t` is in seconds from the start; events are ordered by time, ties keep file/track order.
+ *
+ * ASSUMPTIONS:
+ *  - `duration` is the largest of the last event time and the end-of-track marker time, so trailing silence in the loop is kept.
+ *  - A truncated track keeps the events that were parsed before the damage.
+ */
+
+const EMPTY_TEMPO = Object.freeze([{ tick: 0, t: 0, usPerBeat: 500000, bpm: 120 }]);
+
+function emptyResult() {
+  return { format: 0, ticksPerBeat: 480, trackCount: 0, events: [], tempoMap: EMPTY_TEMPO.map((x) => ({ ...x })), duration: 0 };
+}
+
+/** @param {ArrayBuffer|ArrayBufferView} buf @returns {Uint8Array} */
+function asU8(buf) {
+  if (buf instanceof Uint8Array) return buf;
+  if (ArrayBuffer.isView(buf)) return new Uint8Array(buf.buffer, buf.byteOffset, buf.byteLength);
+  return new Uint8Array(buf);
+}
+
+/**
+ * @param {ArrayBuffer|ArrayBufferView} buf
+ * @returns {{format:number, ticksPerBeat:number, trackCount:number,
+ *   events:{t:number, ch:number, type:string, a:number, b:number}[],
+ *   tempoMap:{tick:number, t:number, usPerBeat:number, bpm:number}[], duration:number}}
+ */
+export function parseMidi(buf) {
+  try {
+    return parse(asU8(buf));
+  } catch {
+    return emptyResult();
+  }
+}
+
+function parse(u8) {
+  const len = u8.length;
+  const tag = (o) => String.fromCharCode(u8[o], u8[o + 1], u8[o + 2], u8[o + 3]);
+  let p = -1;
+  for (let i = 0; i + 14 <= Math.min(len, 64); i++) if (tag(i) === 'MThd') { p = i; break; }
+  if (p < 0) return emptyResult();
+  const dv = new DataView(u8.buffer, u8.byteOffset, u8.byteLength);
+  const hdrLen = dv.getUint32(p + 4, false);
+  if (hdrLen < 6 || p + 8 + hdrLen > len) return emptyResult();
+  const format = dv.getUint16(p + 8, false);
+  const nTracks = dv.getUint16(p + 10, false);
+  const division = dv.getUint16(p + 12, false);
+  p += 8 + hdrLen;
+
+  const smpte = (division & 0x8000) !== 0;
+  let secPerTick = 0;
+  let ticksPerBeat = division & 0x7fff;
+  if (smpte) {
+    let fps = 256 - (division >> 8);
+    if (fps === 29) fps = 29.97;
+    const tpf = division & 0xff;
+    secPerTick = 1 / (fps * Math.max(1, tpf));
+    ticksPerBeat = Math.max(1, Math.round((fps * tpf) / 2)); // defined as ticks per 0.5 s for SMPTE files
+  } else if (ticksPerBeat === 0) {
+    return emptyResult();
+  }
+
+  /** @type {{tick:number, ch:number, type:string, a:number, b:number}[]} */
+  const raw = [];
+  /** @type {{tick:number, usPerBeat:number}[]} */
+  const tempos = [];
+  let endTick = 0;
+  let trackCount = 0;
+
+  while (p + 8 <= len && trackCount < Math.max(nTracks, 1) + 1024) {
+    const id = tag(p);
+    const size = dv.getUint32(p + 4, false);
+    const body = p + 8;
+    const end = Math.min(body + size, len);
+    p = body + size;
+    if (id !== 'MTrk') continue;
+    trackCount++;
+    endTick = Math.max(endTick, parseTrack(u8, body, end, raw, tempos));
+    if (p > len) break;
+  }
+
+  // stable sort by absolute tick (Array.prototype.sort is stable): ties keep track order, then in-track order
+  raw.sort((x, y) => x.tick - y.tick);
+  tempos.sort((x, y) => x.tick - y.tick);
+
+  // tempo map: segments {tick, t, usPerBeat}
+  const map = [{ tick: 0, t: 0, usPerBeat: 500000 }];
+  for (const tp of tempos) {
+    const last = map[map.length - 1];
+    if (tp.tick === last.tick) { last.usPerBeat = tp.usPerBeat; continue; }
+    map.push({ tick: tp.tick, t: 0, usPerBeat: tp.usPerBeat });
+  }
+  for (let i = 1; i < map.length; i++) {
+    map[i].t = map[i - 1].t + (smpte ? 0 : ((map[i].tick - map[i - 1].tick) * map[i - 1].usPerBeat) / 1e6 / ticksPerBeat);
+  }
+  const tickToSec = (tick) => {
+    if (smpte) return tick * secPerTick;
+    let lo = 0;
+    let hi = map.length - 1;
+    while (lo < hi) { // last segment with seg.tick <= tick
+      const mid = (lo + hi + 1) >> 1;
+      if (map[mid].tick <= tick) lo = mid; else hi = mid - 1;
+    }
+    const s = map[lo];
+    return s.t + ((tick - s.tick) * s.usPerBeat) / 1e6 / ticksPerBeat;
+  };
+
+  const events = new Array(raw.length);
+  let duration = 0;
+  for (let i = 0; i < raw.length; i++) {
+    const e = raw[i];
+    const t = tickToSec(e.tick);
+    events[i] = { t, ch: e.ch, type: e.type, a: e.a, b: e.b };
+    if (t > duration) duration = t;
+  }
+  duration = Math.max(duration, tickToSec(endTick));
+  return {
+    format,
+    ticksPerBeat,
+    trackCount,
+    events,
+    tempoMap: map.map((s) => ({ tick: s.tick, t: s.t, usPerBeat: s.usPerBeat, bpm: 60e6 / s.usPerBeat })),
+    duration,
+  };
+}
+
+/** Parse one MTrk body into `raw` / `tempos`; returns the track's final tick (end-of-track marker or last event). */
+function parseTrack(u8, start, end, raw, tempos) {
+  let q = start;
+  let tick = 0;
+  let running = 0;
+  const vlq = () => {
+    let v = 0;
+    for (let n = 0; n < 4 && q < end; n++) {
+      const b = u8[q++];
+      v = (v << 7) | (b & 0x7f);
+      if (!(b & 0x80)) return v;
+    }
+    return v;
+  };
+  while (q < end) {
+    tick += vlq();
+    if (q >= end) break;
+    let status = u8[q];
+    if (status < 0x80) {
+      if (!running) break; // data byte without a status: damaged track
+      status = running;
+    } else {
+      q++;
+      if (status < 0xf0) running = status;
+    }
+    if (status === 0xff) { // meta event
+      running = 0;
+      if (q >= end) break;
+      const type = u8[q++];
+      const n = vlq();
+      if (type === 0x51 && n === 3 && q + 3 <= end) tempos.push({ tick, usPerBeat: (u8[q] << 16) | (u8[q + 1] << 8) | u8[q + 2] });
+      q += n;
+      if (type === 0x2f) break; // end of track
+      continue;
+    }
+    if (status === 0xf0 || status === 0xf7) { // sysex: skipped
+      running = 0;
+      const n = vlq(); // (not `q += vlq()`: the operand q would be read before vlq() advances it)
+      q += n;
+      continue;
+    }
+    if (status > 0xf0) break; // system common / real-time bytes cannot appear in a file
+    const hi = status & 0xf0;
+    const ch = status & 0x0f;
+    const needsTwo = hi !== 0xc0 && hi !== 0xd0;
+    if (q + (needsTwo ? 2 : 1) > end) break;
+    const d1 = u8[q++];
+    const d2 = needsTwo ? u8[q++] : 0;
+    switch (hi) {
+      case 0x80: raw.push({ tick, ch, type: 'noteOff', a: d1, b: d2 }); break;
+      case 0x90: raw.push({ tick, ch, type: d2 === 0 ? 'noteOff' : 'noteOn', a: d1, b: d2 }); break;
+      case 0xa0: raw.push({ tick, ch, type: 'polyPressure', a: d1, b: d2 }); break;
+      case 0xb0: raw.push({ tick, ch, type: 'controlChange', a: d1, b: d2 }); break;
+      case 0xc0: raw.push({ tick, ch, type: 'programChange', a: d1, b: 0 }); break;
+      case 0xd0: raw.push({ tick, ch, type: 'channelPressure', a: d1, b: 0 }); break;
+      case 0xe0: raw.push({ tick, ch, type: 'pitchBend', a: (d1 | (d2 << 7)) - 8192, b: 0 }); break;
+      default: break;
+    }
+  }
+  return tick;
+}
