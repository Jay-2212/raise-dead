index 0000000..f298e85
--- /dev/null
+++ b/public/games/space-cadet/vendor/three/examples/jsm/postprocessing/GTAOPass.js
@@ -0,0 +1,572 @@
+import {
+	AddEquation,
+	Color,
+	CustomBlending,
+	DataTexture,
+	DepthTexture,
+	DepthStencilFormat,
+	DstAlphaFactor,
+	DstColorFactor,
+	HalfFloatType,
+	MeshNormalMaterial,
+	NearestFilter,
+	NoBlending,
