+          if (data.length !== usize) continue;
+          out.set(base, copyOut(data));
+        }
+      } catch {
+        /* skip this entry, keep reading the others */
+      }
+    }
+  } catch {
+    /* corrupt archive: return what we have (normally nothing) */
+  }
+  return out;
