+// ------------------------------------------------------------------------------------------------------------------------------------
+const STAR_HALF = [
+  [0, 10.1], [0.38, 10.95], [0.78, 10.35], [1.12, 11.05], [1.5, 8.5], [2.0, 10.9], [3.4, 11.2], [5.4, 12.4], [6.2, 13.1], [6.0, 13.8],
